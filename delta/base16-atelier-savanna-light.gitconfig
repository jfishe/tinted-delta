; tinted-delta: Atelier Savanna Light (base16-atelier-savanna-light)
; Scheme author: Bram de Haan (http://atelierbramdehaan.nl)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#526057 bg=#ecf4ee red=#b16139 green=#489963
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#87928a"
	plus-style = green
	plus-emph-style = bold green "#87928a"
	minus-empty-line-marker-style = normal "#b16139"
	plus-empty-line-marker-style = normal "#489963"
	line-numbers-minus-style = "#b16139"
	line-numbers-plus-style = "#489963"
	line-numbers-zero-style = "#78877d"
	line-numbers-left-style = "#78877d"
	line-numbers-right-style = "#78877d"
	file-style = bold "#478c90"
	file-decoration-style = "#478c90" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#78877d" box
	hunk-header-file-style = "#55859b"
	hunk-header-line-number-style = "#a07e3b"
	commit-style = raw
	commit-decoration-style = "#a07e3b" box
	blame-palette = "#ecf4ee #dfe7e2"
	map-styles = bold purple => syntax "#87928a", bold cyan => syntax "#dfe7e2"
