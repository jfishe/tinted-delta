; tinted-delta: Ayu Light (base24-ayu-light)
; Scheme author: Tinted Theming (https://github.com/tinted-theming), Ayu Theme (https://github.com/ayu-theme)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#5c6166 bg=#f8f9fa red=#f07171 green=#6cbf49
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#d2d4d8"
	plus-style = green
	plus-emph-style = bold green "#d2d4d8"
	minus-empty-line-marker-style = normal "#f07171"
	plus-empty-line-marker-style = normal "#6cbf49"
	line-numbers-minus-style = "#f07171"
	line-numbers-plus-style = "#6cbf49"
	line-numbers-zero-style = "#a0a6ac"
	line-numbers-left-style = "#a0a6ac"
	line-numbers-right-style = "#a0a6ac"
	file-style = bold "#399ee6"
	file-decoration-style = "#399ee6" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#a0a6ac" box
	hunk-header-file-style = "#a37acc"
	hunk-header-line-number-style = "#f2ae49"
	commit-style = raw
	commit-decoration-style = "#f2ae49" box
	blame-palette = "#f8f9fa #edeff1"
	map-styles = bold purple => syntax "#d2d4d8", bold cyan => syntax "#edeff1"
