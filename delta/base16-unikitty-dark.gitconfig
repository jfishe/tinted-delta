; tinted-delta: Unikitty Dark (base16-unikitty-dark)
; Scheme author: Josh W Lewis (@joshwlewis)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#bcbabe bg=#2e2a31 red=#d8137f green=#17ad98
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#666369"
	plus-style = green
	plus-emph-style = bold green "#666369"
	minus-empty-line-marker-style = normal "#d8137f"
	plus-empty-line-marker-style = normal "#17ad98"
	line-numbers-minus-style = "#d8137f"
	line-numbers-plus-style = "#17ad98"
	line-numbers-zero-style = "#838085"
	line-numbers-left-style = "#838085"
	line-numbers-right-style = "#838085"
	file-style = bold "#796af5"
	file-decoration-style = "#796af5" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#838085" box
	hunk-header-file-style = "#bb60ea"
	hunk-header-line-number-style = "#dc8a0e"
	commit-style = raw
	commit-decoration-style = "#dc8a0e" box
	blame-palette = "#2e2a31 #4a464d"
	map-styles = bold purple => syntax "#666369", bold cyan => syntax "#4a464d"
