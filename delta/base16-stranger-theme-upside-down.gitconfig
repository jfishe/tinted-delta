; tinted-delta: Stranger Theme Upside Down (base16-stranger-theme-upside-down)
; Scheme author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#f8f8f2 bg=#0d1117 red=#e06c75 green=#98c379
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#2a3c4a"
	plus-style = green
	plus-emph-style = bold green "#2a3c4a"
	minus-empty-line-marker-style = normal "#e06c75"
	plus-empty-line-marker-style = normal "#98c379"
	line-numbers-minus-style = "#e06c75"
	line-numbers-plus-style = "#98c379"
	line-numbers-zero-style = "#7a8495"
	line-numbers-left-style = "#7a8495"
	line-numbers-right-style = "#7a8495"
	file-style = bold "#61afef"
	file-decoration-style = "#61afef" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#7a8495" box
	hunk-header-file-style = "#c678dd"
	hunk-header-line-number-style = "#e5c07b"
	commit-style = raw
	commit-decoration-style = "#e5c07b" box
	blame-palette = "#0d1117 #21252b"
	map-styles = bold purple => syntax "#2a3c4a", bold cyan => syntax "#21252b"
