; tinted-delta: Unikitty Light (base16-unikitty-light)
; Scheme author: Josh W Lewis (@joshwlewis)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#6c696e bg=#ffffff red=#d8137f green=#17ad98
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#c4c3c5"
	plus-style = green
	plus-emph-style = bold green "#c4c3c5"
	minus-empty-line-marker-style = normal "#d8137f"
	plus-empty-line-marker-style = normal "#17ad98"
	line-numbers-minus-style = "#d8137f"
	line-numbers-plus-style = "#17ad98"
	line-numbers-zero-style = "#a7a5a8"
	line-numbers-left-style = "#a7a5a8"
	line-numbers-right-style = "#a7a5a8"
	file-style = bold "#775dff"
	file-decoration-style = "#775dff" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#a7a5a8" box
	hunk-header-file-style = "#aa17e6"
	hunk-header-line-number-style = "#dc8a0e"
	commit-style = raw
	commit-decoration-style = "#dc8a0e" box
	blame-palette = "#ffffff #e1e1e2"
	map-styles = bold purple => syntax "#c4c3c5", bold cyan => syntax "#e1e1e2"
