; tinted-delta: Qualia (base16-qualia)
; Scheme author: isaacwhanson
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#c0c0c0 bg=#101010 red=#efa6a2 green=#80c990
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#454545"
	plus-style = green
	plus-emph-style = bold green "#454545"
	minus-empty-line-marker-style = normal "#efa6a2"
	plus-empty-line-marker-style = normal "#80c990"
	line-numbers-minus-style = "#efa6a2"
	line-numbers-plus-style = "#80c990"
	line-numbers-zero-style = "#454545"
	line-numbers-left-style = "#454545"
	line-numbers-right-style = "#454545"
	file-style = bold "#50cacd"
	file-decoration-style = "#50cacd" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#454545" box
	hunk-header-file-style = "#e0af85"
	hunk-header-line-number-style = "#e6a3dc"
	commit-style = raw
	commit-decoration-style = "#e6a3dc" box
	blame-palette = "#101010 #454545"
	map-styles = bold purple => syntax "#454545", bold cyan => syntax "#454545"
