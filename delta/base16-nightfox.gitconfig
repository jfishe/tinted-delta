; tinted-delta: nightfox (base16-nightfox)
; Scheme author: EdenEast (https://github.com/EdenEast)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#cdcecf bg=#192330 red=#c94f6d green=#81b29a
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#29394f"
	plus-style = green
	plus-emph-style = bold green "#29394f"
	minus-empty-line-marker-style = normal "#c94f6d"
	plus-empty-line-marker-style = normal "#81b29a"
	line-numbers-minus-style = "#c94f6d"
	line-numbers-plus-style = "#81b29a"
	line-numbers-zero-style = "#575860"
	line-numbers-left-style = "#575860"
	line-numbers-right-style = "#575860"
	file-style = bold "#719cd6"
	file-decoration-style = "#719cd6" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#575860" box
	hunk-header-file-style = "#9d79d6"
	hunk-header-line-number-style = "#dbc074"
	commit-style = raw
	commit-decoration-style = "#dbc074" box
	blame-palette = "#192330 #212e3f"
	map-styles = bold purple => syntax "#29394f", bold cyan => syntax "#212e3f"
