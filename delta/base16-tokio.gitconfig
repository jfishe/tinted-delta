; tinted-delta: Tokio (base16-tokio)
; Scheme author: xscriptor (https://github.com/xscriptor)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#f7f1ff bg=#1c1c1d red=#fc618d green=#7bd88f
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#363638"
	plus-style = green
	plus-emph-style = bold green "#363638"
	minus-empty-line-marker-style = normal "#fc618d"
	plus-empty-line-marker-style = normal "#7bd88f"
	line-numbers-minus-style = "#fc618d"
	line-numbers-plus-style = "#7bd88f"
	line-numbers-zero-style = "#78757c"
	line-numbers-left-style = "#78757c"
	line-numbers-right-style = "#78757c"
	file-style = bold "#fd9353"
	file-decoration-style = "#fd9353" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#78757c" box
	hunk-header-file-style = "#948ae3"
	hunk-header-line-number-style = "#fce566"
	commit-style = raw
	commit-decoration-style = "#fce566" box
	blame-palette = "#1c1c1d #2b2b2d"
	map-styles = bold purple => syntax "#363638", bold cyan => syntax "#2b2b2d"
