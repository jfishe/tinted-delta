; tinted-delta: Wryan (base24-wryan)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#768488 bg=#101010 red=#8c4665 green=#287373
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#3d3d3d"
	plus-style = green
	plus-emph-style = bold green "#3d3d3d"
	minus-empty-line-marker-style = normal "#8c4665"
	plus-empty-line-marker-style = normal "#287373"
	line-numbers-minus-style = "#8c4665"
	line-numbers-plus-style = "#287373"
	line-numbers-zero-style = "#505456"
	line-numbers-left-style = "#505456"
	line-numbers-right-style = "#505456"
	file-style = bold "#395573"
	file-decoration-style = "#395573" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#505456" box
	hunk-header-file-style = "#5e468c"
	hunk-header-line-number-style = "#477ab3"
	commit-style = raw
	commit-decoration-style = "#477ab3" box
	blame-palette = "#101010 #333333"
	map-styles = bold purple => syntax "#3d3d3d", bold cyan => syntax "#333333"
