; tinted-delta: Hipster Green (base24-hipster-green)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#a8a8a8 bg=#0f0a05 red=#b6204a green=#00a600
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#666666"
	plus-style = green
	plus-emph-style = bold green "#666666"
	minus-empty-line-marker-style = normal "#b6204a"
	plus-empty-line-marker-style = normal "#00a600"
	line-numbers-minus-style = "#b6204a"
	line-numbers-plus-style = "#00a600"
	line-numbers-zero-style = "#7c7c7c"
	line-numbers-left-style = "#7c7c7c"
	line-numbers-right-style = "#7c7c7c"
	file-style = bold "#246db2"
	file-decoration-style = "#246db2" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#7c7c7c" box
	hunk-header-file-style = "#b200b2"
	hunk-header-line-number-style = "#0000ff"
	commit-style = raw
	commit-decoration-style = "#0000ff" box
	blame-palette = "#0f0a05 #000000"
	map-styles = bold purple => syntax "#666666", bold cyan => syntax "#000000"
