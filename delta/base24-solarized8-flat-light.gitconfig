; tinted-delta: Solarized 8 Flat Light (base24-solarized8-flat-light)
; Scheme author: jfishe (generated by colortemplate2tinty)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#657b83 bg=#fdf6e3 red=#dc322f green=#859900
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#93a1a1"
	plus-style = green
	plus-emph-style = bold green "#93a1a1"
	minus-empty-line-marker-style = normal "#dc322f"
	plus-empty-line-marker-style = normal "#859900"
	line-numbers-minus-style = "#dc322f"
	line-numbers-plus-style = "#859900"
	line-numbers-zero-style = "#839496"
	line-numbers-left-style = "#839496"
	line-numbers-right-style = "#839496"
	file-style = bold "#268bd2"
	file-decoration-style = "#268bd2" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#839496" box
	hunk-header-file-style = "#d33682"
	hunk-header-line-number-style = "#b58900"
	commit-style = raw
	commit-decoration-style = "#b58900" box
	blame-palette = "#fdf6e3 #eee8d5"
	map-styles = bold purple => syntax "#93a1a1", bold cyan => syntax "#eee8d5"
