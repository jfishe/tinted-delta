; tinted-delta: Equilibrium Gray Dark (base16-equilibrium-gray-dark)
; Scheme author: Carlo Abelli
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#ababab bg=#111111 red=#f04339 green=#7f8b00
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#262626"
	plus-style = green
	plus-emph-style = bold green "#262626"
	minus-empty-line-marker-style = normal "#f04339"
	plus-empty-line-marker-style = normal "#7f8b00"
	line-numbers-minus-style = "#f04339"
	line-numbers-plus-style = "#7f8b00"
	line-numbers-zero-style = "#777777"
	line-numbers-left-style = "#777777"
	line-numbers-right-style = "#777777"
	file-style = bold "#008dd1"
	file-decoration-style = "#008dd1" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#777777" box
	hunk-header-file-style = "#6a7fd2"
	hunk-header-line-number-style = "#bb8801"
	commit-style = raw
	commit-decoration-style = "#bb8801" box
	blame-palette = "#111111 #1b1b1b"
	map-styles = bold purple => syntax "#262626", bold cyan => syntax "#1b1b1b"
