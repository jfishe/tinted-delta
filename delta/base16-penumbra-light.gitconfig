; tinted-delta: Penumbra Light (base16-penumbra-light)
; Scheme author: Neal McKee (https://github.com/nealmckee/penumbra)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#8b8b8b bg=#efe8dd red=#bb626b green=#509259
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#d1ccc5"
	plus-style = green
	plus-emph-style = bold green "#d1ccc5"
	minus-empty-line-marker-style = normal "#bb626b"
	plus-empty-line-marker-style = normal "#509259"
	line-numbers-minus-style = "#bb626b"
	line-numbers-plus-style = "#509259"
	line-numbers-zero-style = "#b4b1ad"
	line-numbers-left-style = "#b4b1ad"
	line-numbers-right-style = "#b4b1ad"
	file-style = bold "#0082b5"
	file-decoration-style = "#0082b5" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#b4b1ad" box
	hunk-header-file-style = "#7177b0"
	hunk-header-line-number-style = "#958a1c"
	commit-style = raw
	commit-decoration-style = "#958a1c" box
	blame-palette = "#efe8dd #dfd9d0"
	map-styles = bold purple => syntax "#d1ccc5", bold cyan => syntax "#dfd9d0"
