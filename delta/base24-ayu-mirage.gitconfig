; tinted-delta: Ayu Mirage (base24-ayu-mirage)
; Scheme author: Tinted Theming (https://github.com/tinted-theming), Ayu Theme (https://github.com/ayu-theme)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#cccac2 bg=#1f2430 red=#f28779 green=#d5ff80
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#323844"
	plus-style = green
	plus-emph-style = bold green "#323844"
	minus-empty-line-marker-style = normal "#f28779"
	plus-empty-line-marker-style = normal "#d5ff80"
	line-numbers-minus-style = "#f28779"
	line-numbers-plus-style = "#d5ff80"
	line-numbers-zero-style = "#4a5059"
	line-numbers-left-style = "#4a5059"
	line-numbers-right-style = "#4a5059"
	file-style = bold "#73d0ff"
	file-decoration-style = "#73d0ff" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#4a5059" box
	hunk-header-file-style = "#d4bfff"
	hunk-header-line-number-style = "#ffd173"
	commit-style = raw
	commit-decoration-style = "#ffd173" box
	blame-palette = "#1f2430 #242936"
	map-styles = bold purple => syntax "#323844", bold cyan => syntax "#242936"
