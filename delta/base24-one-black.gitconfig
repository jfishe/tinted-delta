; tinted-delta: One Black (base24-one-black)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#abb2bf bg=#000000 red=#e05561 green=#8cc265
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#4f5666"
	plus-style = green
	plus-emph-style = bold green "#4f5666"
	minus-empty-line-marker-style = normal "#e05561"
	plus-empty-line-marker-style = normal "#8cc265"
	line-numbers-minus-style = "#e05561"
	line-numbers-plus-style = "#8cc265"
	line-numbers-zero-style = "#545862"
	line-numbers-left-style = "#545862"
	line-numbers-right-style = "#545862"
	file-style = bold "#4aa5f0"
	file-decoration-style = "#4aa5f0" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#545862" box
	hunk-header-file-style = "#c162de"
	hunk-header-line-number-style = "#e6b965"
	commit-style = raw
	commit-decoration-style = "#e6b965" box
	blame-palette = "#000000 #000000"
	map-styles = bold purple => syntax "#4f5666", bold cyan => syntax "#000000"
