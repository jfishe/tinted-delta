; tinted-delta: CLRS (base24-clrs)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#9a9b9a bg=#ffffff red=#f72729 green=#32895c
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#545753"
	plus-style = green
	plus-emph-style = bold green "#545753"
	minus-empty-line-marker-style = normal "#f72729"
	plus-empty-line-marker-style = normal "#32895c"
	line-numbers-minus-style = "#f72729"
	line-numbers-plus-style = "#32895c"
	line-numbers-zero-style = "#6b6d6a"
	line-numbers-left-style = "#6b6d6a"
	line-numbers-right-style = "#6b6d6a"
	file-style = bold "#125ccf"
	file-decoration-style = "#125ccf" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#6b6d6a" box
	hunk-header-file-style = "#9f00bc"
	hunk-header-line-number-style = "#156ffe"
	commit-style = raw
	commit-decoration-style = "#156ffe" box
	blame-palette = "#ffffff #000000"
	map-styles = bold purple => syntax "#545753", bold cyan => syntax "#000000"
