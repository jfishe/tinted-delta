; tinted-delta: Edge Dark (base16-edge-dark)
; Scheme author: cjayross (https://github.com/cjayross), Tinted Theming (https://github.com/tinted-theming)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#afb2b5 bg=#262729 red=#e77171 green=#a1bf78
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#3d3f42"
	plus-style = green
	plus-emph-style = bold green "#3d3f42"
	minus-empty-line-marker-style = normal "#e77171"
	plus-empty-line-marker-style = normal "#a1bf78"
	line-numbers-minus-style = "#e77171"
	line-numbers-plus-style = "#a1bf78"
	line-numbers-zero-style = "#4a4c4f"
	line-numbers-left-style = "#4a4c4f"
	line-numbers-right-style = "#4a4c4f"
	file-style = bold "#73b3e7"
	file-decoration-style = "#73b3e7" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#4a4c4f" box
	hunk-header-file-style = "#d390e7"
	hunk-header-line-number-style = "#dbb774"
	commit-style = raw
	commit-decoration-style = "#dbb774" box
	blame-palette = "#262729 #313235"
	map-styles = bold purple => syntax "#3d3f42", bold cyan => syntax "#313235"
