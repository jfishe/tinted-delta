; tinted-delta: Obsidian (base24-obsidian)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#a1a1a1 bg=#273032 red=#a50001 green=#00bb00
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#555555"
	plus-style = green
	plus-emph-style = bold green "#555555"
	minus-empty-line-marker-style = normal "#a50001"
	plus-empty-line-marker-style = normal "#00bb00"
	line-numbers-minus-style = "#a50001"
	line-numbers-plus-style = "#00bb00"
	line-numbers-zero-style = "#6e6e6e"
	line-numbers-left-style = "#6e6e6e"
	line-numbers-right-style = "#6e6e6e"
	file-style = bold "#399bda"
	file-decoration-style = "#399bda" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#6e6e6e" box
	hunk-header-file-style = "#bb00bb"
	hunk-header-line-number-style = "#a0d6ff"
	commit-style = raw
	commit-decoration-style = "#a0d6ff" box
	blame-palette = "#273032 #000000"
	map-styles = bold purple => syntax "#555555", bold cyan => syntax "#000000"
