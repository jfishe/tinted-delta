; tinted-delta: WWDC16 Dark (base24-wwdc16-dark)
; Scheme author: jfishe (generated by colortemplate2tinty)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#ffffff bg=#292c36 red=#e64547 green=#42a647
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#949494"
	plus-style = green
	plus-emph-style = bold green "#949494"
	minus-empty-line-marker-style = normal "#e64547"
	plus-empty-line-marker-style = normal "#42a647"
	line-numbers-minus-style = "#e64547"
	line-numbers-plus-style = "#42a647"
	line-numbers-zero-style = "#949494"
	line-numbers-left-style = "#949494"
	line-numbers-right-style = "#949494"
	file-style = bold "#4670d8"
	file-decoration-style = "#4670d8" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#949494" box
	hunk-header-file-style = "#d24e9b"
	hunk-header-line-number-style = "#c98351"
	commit-style = raw
	commit-decoration-style = "#c98351" box
	blame-palette = "#292c36 #353547"
	map-styles = bold purple => syntax "#949494", bold cyan => syntax "#353547"
