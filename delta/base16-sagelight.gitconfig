; tinted-delta: Sagelight (base16-sagelight)
; Scheme author: Carter Veldhuizen
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#383838 bg=#f8f8f8 red=#fa8480 green=#a0d2c8
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#d8d8d8"
	plus-style = green
	plus-emph-style = bold green "#d8d8d8"
	minus-empty-line-marker-style = normal "#fa8480"
	plus-empty-line-marker-style = normal "#a0d2c8"
	line-numbers-minus-style = "#fa8480"
	line-numbers-plus-style = "#a0d2c8"
	line-numbers-zero-style = "#b8b8b8"
	line-numbers-left-style = "#b8b8b8"
	line-numbers-right-style = "#b8b8b8"
	file-style = bold "#a0a7d2"
	file-decoration-style = "#a0a7d2" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#b8b8b8" box
	hunk-header-file-style = "#c8a0d2"
	hunk-header-line-number-style = "#ffdc61"
	commit-style = raw
	commit-decoration-style = "#ffdc61" box
	blame-palette = "#f8f8f8 #e8e8e8"
	map-styles = bold purple => syntax "#d8d8d8", bold cyan => syntax "#e8e8e8"
