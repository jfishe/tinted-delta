; tinted-delta: Molokai (base24-molokai)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#a1a1a1 bg=#121212 red=#fa2573 green=#97e123
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#555555"
	plus-style = green
	plus-emph-style = bold green "#555555"
	minus-empty-line-marker-style = normal "#fa2573"
	plus-empty-line-marker-style = normal "#97e123"
	line-numbers-minus-style = "#fa2573"
	line-numbers-plus-style = "#97e123"
	line-numbers-zero-style = "#6e6e6e"
	line-numbers-left-style = "#6e6e6e"
	line-numbers-right-style = "#6e6e6e"
	file-style = bold "#0f7fcf"
	file-decoration-style = "#0f7fcf" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#6e6e6e" box
	hunk-header-file-style = "#8700ff"
	hunk-header-line-number-style = "#00afff"
	commit-style = raw
	commit-decoration-style = "#00afff" box
	blame-palette = "#121212 #121212"
	map-styles = bold purple => syntax "#555555", bold cyan => syntax "#121212"
