; tinted-delta: Kanagawa Dragon (base16-kanagawa-dragon)
; Scheme author: Stefan Weigl-Bosker (https://github.com/sweiglbosker), Tommaso Laurenzi (https://github.com/rebelot/kanagawa.nvim)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#c5c9c5 bg=#181616 red=#c4746e green=#8a9a7b
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#393836"
	plus-style = green
	plus-emph-style = bold green "#393836"
	minus-empty-line-marker-style = normal "#c4746e"
	plus-empty-line-marker-style = normal "#8a9a7b"
	line-numbers-minus-style = "#c4746e"
	line-numbers-plus-style = "#8a9a7b"
	line-numbers-zero-style = "#625e5a"
	line-numbers-left-style = "#625e5a"
	line-numbers-right-style = "#625e5a"
	file-style = bold "#8ba4b0"
	file-decoration-style = "#8ba4b0" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#625e5a" box
	hunk-header-file-style = "#a292a3"
	hunk-header-line-number-style = "#c4b28a"
	commit-style = raw
	commit-decoration-style = "#c4b28a" box
	blame-palette = "#181616 #282727"
	map-styles = bold purple => syntax "#393836", bold cyan => syntax "#282727"
