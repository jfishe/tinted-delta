; tinted-delta: Ocean (base16-ocean)
; Scheme author: Chris Kempson (http://chriskempson.com)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#c0c5ce bg=#2b303b red=#bf616a green=#a3be8c
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#4f5b66"
	plus-style = green
	plus-emph-style = bold green "#4f5b66"
	minus-empty-line-marker-style = normal "#bf616a"
	plus-empty-line-marker-style = normal "#a3be8c"
	line-numbers-minus-style = "#bf616a"
	line-numbers-plus-style = "#a3be8c"
	line-numbers-zero-style = "#65737e"
	line-numbers-left-style = "#65737e"
	line-numbers-right-style = "#65737e"
	file-style = bold "#8fa1b3"
	file-decoration-style = "#8fa1b3" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#65737e" box
	hunk-header-file-style = "#b48ead"
	hunk-header-line-number-style = "#ebcb8b"
	commit-style = raw
	commit-decoration-style = "#ebcb8b" box
	blame-palette = "#2b303b #343d46"
	map-styles = bold purple => syntax "#4f5b66", bold cyan => syntax "#343d46"
