; tinted-delta: Atelier Heath Light (base16-atelier-heath-light)
; Scheme author: Bram de Haan (http://atelierbramdehaan.nl)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#695d69 bg=#f7f3f7 red=#ca402b green=#918b3b
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#ab9bab"
	plus-style = green
	plus-emph-style = bold green "#ab9bab"
	minus-empty-line-marker-style = normal "#ca402b"
	plus-empty-line-marker-style = normal "#918b3b"
	line-numbers-minus-style = "#ca402b"
	line-numbers-plus-style = "#918b3b"
	line-numbers-zero-style = "#9e8f9e"
	line-numbers-left-style = "#9e8f9e"
	line-numbers-right-style = "#9e8f9e"
	file-style = bold "#516aec"
	file-decoration-style = "#516aec" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#9e8f9e" box
	hunk-header-file-style = "#7b59c0"
	hunk-header-line-number-style = "#bb8a35"
	commit-style = raw
	commit-decoration-style = "#bb8a35" box
	blame-palette = "#f7f3f7 #d8cad8"
	map-styles = bold purple => syntax "#ab9bab", bold cyan => syntax "#d8cad8"
