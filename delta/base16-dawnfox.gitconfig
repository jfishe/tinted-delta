; tinted-delta: dawnfox (base16-dawnfox)
; Scheme author: EdenEast (https://github.com/EdenEast)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#575279 bg=#faf4ed red=#b4637a green=#618774
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#ebdfe4"
	plus-style = green
	plus-emph-style = bold green "#ebdfe4"
	minus-empty-line-marker-style = normal "#b4637a"
	plus-empty-line-marker-style = normal "#618774"
	line-numbers-minus-style = "#b4637a"
	line-numbers-plus-style = "#618774"
	line-numbers-zero-style = "#5f5695"
	line-numbers-left-style = "#5f5695"
	line-numbers-right-style = "#5f5695"
	file-style = bold "#286983"
	file-decoration-style = "#286983" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#5f5695" box
	hunk-header-file-style = "#907aa9"
	hunk-header-line-number-style = "#ea9d34"
	commit-style = raw
	commit-decoration-style = "#ea9d34" box
	blame-palette = "#faf4ed #ebe0df"
	map-styles = bold purple => syntax "#ebdfe4", bold cyan => syntax "#ebe0df"
