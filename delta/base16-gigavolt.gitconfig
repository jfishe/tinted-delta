; tinted-delta: Gigavolt (base16-gigavolt)
; Scheme author: Aidan Swope (http://github.com/Whillikers)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#e9e7e1 bg=#202126 red=#ff661a green=#f2e6a9
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#5a576e"
	plus-style = green
	plus-emph-style = bold green "#5a576e"
	minus-empty-line-marker-style = normal "#ff661a"
	plus-empty-line-marker-style = normal "#f2e6a9"
	line-numbers-minus-style = "#ff661a"
	line-numbers-plus-style = "#f2e6a9"
	line-numbers-zero-style = "#a1d2e6"
	line-numbers-left-style = "#a1d2e6"
	line-numbers-right-style = "#a1d2e6"
	file-style = bold "#40bfff"
	file-decoration-style = "#40bfff" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#a1d2e6" box
	hunk-header-file-style = "#ae94f9"
	hunk-header-line-number-style = "#ffdc2d"
	commit-style = raw
	commit-decoration-style = "#ffdc2d" box
	blame-palette = "#202126 #2d303d"
	map-styles = bold purple => syntax "#5a576e", bold cyan => syntax "#2d303d"
