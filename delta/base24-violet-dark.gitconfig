; tinted-delta: Violet Dark (base24-violet-dark)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#a7a59f bg=#1b1d1f red=#c94c22 green=#85981c
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#45484b"
	plus-style = green
	plus-emph-style = bold green "#45484b"
	minus-empty-line-marker-style = normal "#c94c22"
	plus-empty-line-marker-style = normal "#85981c"
	line-numbers-minus-style = "#c94c22"
	line-numbers-plus-style = "#85981c"
	line-numbers-zero-style = "#656767"
	line-numbers-left-style = "#656767"
	line-numbers-right-style = "#656767"
	file-style = bold "#2e8bce"
	file-decoration-style = "#2e8bce" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#656767" box
	hunk-header-file-style = "#d13a82"
	hunk-header-line-number-style = "#2075c7"
	commit-style = raw
	commit-decoration-style = "#2075c7" box
	blame-palette = "#1b1d1f #56595c"
	map-styles = bold purple => syntax "#45484b", bold cyan => syntax "#56595c"
