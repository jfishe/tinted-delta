; tinted-delta: Seafoam Pastel (base24-seafoam-pastel)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#cacaca bg=#243434 red=#825d4d green=#718c61
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#8a8a8a"
	plus-style = green
	plus-emph-style = bold green "#8a8a8a"
	minus-empty-line-marker-style = normal "#825d4d"
	plus-empty-line-marker-style = normal "#718c61"
	line-numbers-minus-style = "#825d4d"
	line-numbers-plus-style = "#718c61"
	line-numbers-zero-style = "#9f9f9f"
	line-numbers-left-style = "#9f9f9f"
	line-numbers-right-style = "#9f9f9f"
	file-style = bold "#4d7b82"
	file-decoration-style = "#4d7b82" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#9f9f9f" box
	hunk-header-file-style = "#8a7167"
	hunk-header-line-number-style = "#79c3cf"
	commit-style = raw
	commit-decoration-style = "#79c3cf" box
	blame-palette = "#243434 #757575"
	map-styles = bold purple => syntax "#8a8a8a", bold cyan => syntax "#757575"
