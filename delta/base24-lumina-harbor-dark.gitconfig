; tinted-delta: Lumina Harbor Dark (base24-lumina-harbor-dark)
; Scheme author: Razik Ikhlef (https://github.com/RazikSF)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#dde1eb bg=#0d111d red=#d0756c green=#9bd8b4
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#1a1f2d"
	plus-style = green
	plus-emph-style = bold green "#1a1f2d"
	minus-empty-line-marker-style = normal "#d0756c"
	plus-empty-line-marker-style = normal "#9bd8b4"
	line-numbers-minus-style = "#d0756c"
	line-numbers-plus-style = "#9bd8b4"
	line-numbers-zero-style = "#232837"
	line-numbers-left-style = "#232837"
	line-numbers-right-style = "#232837"
	file-style = bold "#91c5ea"
	file-decoration-style = "#91c5ea" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#232837" box
	hunk-header-file-style = "#c1bbef"
	hunk-header-line-number-style = "#eace8c"
	commit-style = raw
	commit-decoration-style = "#eace8c" box
	blame-palette = "#0d111d #111523"
	map-styles = bold purple => syntax "#1a1f2d", bold cyan => syntax "#111523"
