; tinted-delta: Espresso (base16-espresso)
; Scheme author: Unknown. Maintained by Alex Mirrington (https://github.com/alexmirrington)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#cccccc bg=#2d2d2d red=#d25252 green=#a5c261
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#515151"
	plus-style = green
	plus-emph-style = bold green "#515151"
	minus-empty-line-marker-style = normal "#d25252"
	plus-empty-line-marker-style = normal "#a5c261"
	line-numbers-minus-style = "#d25252"
	line-numbers-plus-style = "#a5c261"
	line-numbers-zero-style = "#777777"
	line-numbers-left-style = "#777777"
	line-numbers-right-style = "#777777"
	file-style = bold "#6c99bb"
	file-decoration-style = "#6c99bb" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#777777" box
	hunk-header-file-style = "#d197d9"
	hunk-header-line-number-style = "#ffc66d"
	commit-style = raw
	commit-decoration-style = "#ffc66d" box
	blame-palette = "#2d2d2d #393939"
	map-styles = bold purple => syntax "#515151", bold cyan => syntax "#393939"
