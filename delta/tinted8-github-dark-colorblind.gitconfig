; tinted-delta: Github Dark Colorblind (tinted8-github-dark-colorblind)
; Scheme author: Tinted Theming (https://github.com/tinted-theming)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#f0f6fc bg=#0d1117 red=#f0883e green=#58a6ff
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#656c76"
	plus-style = green
	plus-emph-style = bold green "#656c76"
	minus-empty-line-marker-style = normal "#f0883e"
	plus-empty-line-marker-style = normal "#58a6ff"
	line-numbers-minus-style = "#f0883e"
	line-numbers-plus-style = "#58a6ff"
	line-numbers-zero-style = "#656c76"
	line-numbers-left-style = "#656c76"
	line-numbers-right-style = "#656c76"
	file-style = bold "#58a6ff"
	file-decoration-style = "#58a6ff" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#656c76" box
	hunk-header-file-style = "#be8fff"
	hunk-header-line-number-style = "#d29922"
	commit-style = raw
	commit-decoration-style = "#d29922" box
	blame-palette = "#0d1117 #151b23"
	map-styles = bold purple => syntax "#656c76", bold cyan => syntax "#484e55"
