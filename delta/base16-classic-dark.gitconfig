; tinted-delta: Classic Dark (base16-classic-dark)
; Scheme author: Jason Heeris (http://heeris.id.au)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#d0d0d0 bg=#151515 red=#ac4142 green=#90a959
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#303030"
	plus-style = green
	plus-emph-style = bold green "#303030"
	minus-empty-line-marker-style = normal "#ac4142"
	plus-empty-line-marker-style = normal "#90a959"
	line-numbers-minus-style = "#ac4142"
	line-numbers-plus-style = "#90a959"
	line-numbers-zero-style = "#505050"
	line-numbers-left-style = "#505050"
	line-numbers-right-style = "#505050"
	file-style = bold "#6a9fb5"
	file-decoration-style = "#6a9fb5" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#505050" box
	hunk-header-file-style = "#aa759f"
	hunk-header-line-number-style = "#f4bf75"
	commit-style = raw
	commit-decoration-style = "#f4bf75" box
	blame-palette = "#151515 #202020"
	map-styles = bold purple => syntax "#303030", bold cyan => syntax "#202020"
