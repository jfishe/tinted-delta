; tinted-delta: Ayu Dark (base16-ayu-dark)
; Scheme author: Tinted Theming (https://github.com/tinted-theming), Ayu Theme (https://github.com/ayu-theme)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#e6e1cf bg=#0b0e14 red=#f07178 green=#aad94c
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#202229"
	plus-style = green
	plus-emph-style = bold green "#202229"
	minus-empty-line-marker-style = normal "#f07178"
	plus-empty-line-marker-style = normal "#aad94c"
	line-numbers-minus-style = "#f07178"
	line-numbers-plus-style = "#aad94c"
	line-numbers-zero-style = "#3e4b59"
	line-numbers-left-style = "#3e4b59"
	line-numbers-right-style = "#3e4b59"
	file-style = bold "#59c2ff"
	file-decoration-style = "#59c2ff" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#3e4b59" box
	hunk-header-file-style = "#d2a6ff"
	hunk-header-line-number-style = "#ffb454"
	commit-style = raw
	commit-decoration-style = "#ffb454" box
	blame-palette = "#0b0e14 #131721"
	map-styles = bold purple => syntax "#202229", bold cyan => syntax "#131721"
