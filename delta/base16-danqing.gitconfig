; tinted-delta: DanQing (base16-danqing)
; Scheme author: Wenhan Zhu (Cosmos) (zhuwenhan950913@gmail.com)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#e0f0ef bg=#2d302f red=#f9906f green=#8ab361
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#5a605d"
	plus-style = green
	plus-emph-style = bold green "#5a605d"
	minus-empty-line-marker-style = normal "#f9906f"
	plus-empty-line-marker-style = normal "#8ab361"
	line-numbers-minus-style = "#f9906f"
	line-numbers-plus-style = "#8ab361"
	line-numbers-zero-style = "#9da8a3"
	line-numbers-left-style = "#9da8a3"
	line-numbers-right-style = "#9da8a3"
	file-style = bold "#b0a4e3"
	file-decoration-style = "#b0a4e3" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#9da8a3" box
	hunk-header-file-style = "#cca4e3"
	hunk-header-line-number-style = "#f0c239"
	commit-style = raw
	commit-decoration-style = "#f0c239" box
	blame-palette = "#2d302f #434846"
	map-styles = bold purple => syntax "#5a605d", bold cyan => syntax "#434846"
