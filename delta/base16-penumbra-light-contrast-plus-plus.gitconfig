; tinted-delta: Penumbra Light Contrast Plus Plus (base16-penumbra-light-contrast-plus-plus)
; Scheme author: Zachary Weiss (https://github.com/zacharyweiss)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#636363 bg=#fffdfb red=#f58c81 green=#54c794
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#f2e6d4"
	plus-style = green
	plus-emph-style = bold green "#f2e6d4"
	minus-empty-line-marker-style = normal "#f58c81"
	plus-empty-line-marker-style = normal "#54c794"
	line-numbers-minus-style = "#f58c81"
	line-numbers-plus-style = "#54c794"
	line-numbers-zero-style = "#dedede"
	line-numbers-left-style = "#dedede"
	line-numbers-right-style = "#dedede"
	file-style = bold "#6eb2fd"
	file-decoration-style = "#6eb2fd" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#dedede" box
	hunk-header-file-style = "#b69cf6"
	hunk-header-line-number-style = "#a9b852"
	commit-style = raw
	commit-decoration-style = "#a9b852" box
	blame-palette = "#fffdfb #fff7ed"
	map-styles = bold purple => syntax "#f2e6d4", bold cyan => syntax "#fff7ed"
