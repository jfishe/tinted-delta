; tinted-delta: Gruvbox dark (base16-gruvbox-dark)
; Scheme author: Tinted Theming (https://github.com/tinted-theming), morhetz (https://github.com/morhetz/gruvbox)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#ebdbb2 bg=#282828 red=#cc241d green=#98971a
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#504945"
	plus-style = green
	plus-emph-style = bold green "#504945"
	minus-empty-line-marker-style = normal "#cc241d"
	plus-empty-line-marker-style = normal "#98971a"
	line-numbers-minus-style = "#cc241d"
	line-numbers-plus-style = "#98971a"
	line-numbers-zero-style = "#665c54"
	line-numbers-left-style = "#665c54"
	line-numbers-right-style = "#665c54"
	file-style = bold "#458588"
	file-decoration-style = "#458588" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#665c54" box
	hunk-header-file-style = "#b16286"
	hunk-header-line-number-style = "#d79921"
	commit-style = raw
	commit-decoration-style = "#d79921" box
	blame-palette = "#282828 #3c3836"
	map-styles = bold purple => syntax "#504945", bold cyan => syntax "#3c3836"
