; tinted-delta: Embarcadero (base24-embarcadero)
; Scheme author: Thomas Leon Highbaugh
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#bcbdc0 bg=#252a2f red=#ed5d86 green=#20c290
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#616568"
	plus-style = green
	plus-emph-style = bold green "#616568"
	minus-empty-line-marker-style = normal "#ed5d86"
	plus-empty-line-marker-style = normal "#20c290"
	line-numbers-minus-style = "#ed5d86"
	line-numbers-plus-style = "#20c290"
	line-numbers-zero-style = "#7f8285"
	line-numbers-left-style = "#7f8285"
	line-numbers-right-style = "#7f8285"
	file-style = bold "#4080d0"
	file-decoration-style = "#4080d0" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#7f8285" box
	hunk-header-file-style = "#a070d0"
	hunk-header-line-number-style = "#eb824d"
	commit-style = raw
	commit-decoration-style = "#eb824d" box
	blame-palette = "#252a2f #43474c"
	map-styles = bold purple => syntax "#616568", bold cyan => syntax "#43474c"
