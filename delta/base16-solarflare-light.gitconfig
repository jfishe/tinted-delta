; tinted-delta: Solar Flare Light (base16-solarflare-light)
; Scheme author: Chuck Harmston (https://chuck.harmston.ch)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#586875 bg=#f5f7fa red=#ef5253 green=#7cc844
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#a6afb8"
	plus-style = green
	plus-emph-style = bold green "#a6afb8"
	minus-empty-line-marker-style = normal "#ef5253"
	plus-empty-line-marker-style = normal "#7cc844"
	line-numbers-minus-style = "#ef5253"
	line-numbers-plus-style = "#7cc844"
	line-numbers-zero-style = "#85939e"
	line-numbers-left-style = "#85939e"
	line-numbers-right-style = "#85939e"
	file-style = bold "#33b5e1"
	file-decoration-style = "#33b5e1" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#85939e" box
	hunk-header-file-style = "#a363d5"
	hunk-header-line-number-style = "#e4b51c"
	commit-style = raw
	commit-decoration-style = "#e4b51c" box
	blame-palette = "#f5f7fa #e8e9ed"
	map-styles = bold purple => syntax "#a6afb8", bold cyan => syntax "#e8e9ed"
