; tinted-delta: Galaxy (base24-galaxy)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#a1a1a1 bg=#1c2836 red=#f9555f green=#20af89
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#555555"
	plus-style = green
	plus-emph-style = bold green "#555555"
	minus-empty-line-marker-style = normal "#f9555f"
	plus-empty-line-marker-style = normal "#20af89"
	line-numbers-minus-style = "#f9555f"
	line-numbers-plus-style = "#20af89"
	line-numbers-zero-style = "#6e6e6e"
	line-numbers-left-style = "#6e6e6e"
	line-numbers-right-style = "#6e6e6e"
	file-style = bold "#589cf5"
	file-decoration-style = "#589cf5" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#6e6e6e" box
	hunk-header-file-style = "#934d95"
	hunk-header-line-number-style = "#fdf029"
	commit-style = raw
	commit-decoration-style = "#fdf029" box
	blame-palette = "#1c2836 #000000"
	map-styles = bold purple => syntax "#555555", bold cyan => syntax "#000000"
