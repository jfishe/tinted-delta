; tinted-delta: Corduroy Dark (base16-corduroy-dark)
; Scheme author: taysatte (https://github.com/taysatte)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#ddd8df bg=#141016 red=#e8758a green=#55a0a0
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#221a26"
	plus-style = green
	plus-emph-style = bold green "#221a26"
	minus-empty-line-marker-style = normal "#e8758a"
	plus-empty-line-marker-style = normal "#55a0a0"
	line-numbers-minus-style = "#e8758a"
	line-numbers-plus-style = "#55a0a0"
	line-numbers-zero-style = "#7d7082"
	line-numbers-left-style = "#7d7082"
	line-numbers-right-style = "#7d7082"
	file-style = bold "#dc92a3"
	file-decoration-style = "#dc92a3" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#7d7082" box
	hunk-header-file-style = "#cf98c4"
	hunk-header-line-number-style = "#f0bd9c"
	commit-style = raw
	commit-decoration-style = "#f0bd9c" box
	blame-palette = "#141016 #1b151e"
	map-styles = bold purple => syntax "#221a26", bold cyan => syntax "#1b151e"
