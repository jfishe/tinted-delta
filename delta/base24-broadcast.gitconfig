; tinted-delta: Broadcast (base24-broadcast)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#cbcbcb bg=#2b2b2b red=#da4939 green=#519f50
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#323232"
	plus-style = green
	plus-emph-style = bold green "#323232"
	minus-empty-line-marker-style = normal "#da4939"
	plus-empty-line-marker-style = normal "#519f50"
	line-numbers-minus-style = "#da4939"
	line-numbers-plus-style = "#519f50"
	line-numbers-zero-style = "#656565"
	line-numbers-left-style = "#656565"
	line-numbers-right-style = "#656565"
	file-style = bold "#6d9cbe"
	file-decoration-style = "#6d9cbe" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#656565" box
	hunk-header-file-style = "#d0d0ff"
	hunk-header-line-number-style = "#9fcef0"
	commit-style = raw
	commit-decoration-style = "#9fcef0" box
	blame-palette = "#2b2b2b #000000"
	map-styles = bold purple => syntax "#323232", bold cyan => syntax "#000000"
