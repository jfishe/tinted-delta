; tinted-delta: Everforest Light (Soft) (base16-everforest-light-soft)
; Scheme author: Márcio Sobel (https://github.com/marciosobel)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#5c6a72 bg=#f3ead3 red=#f85552 green=#8da101
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#ddd8be"
	plus-style = green
	plus-emph-style = bold green "#ddd8be"
	minus-empty-line-marker-style = normal "#f85552"
	plus-empty-line-marker-style = normal "#8da101"
	line-numbers-minus-style = "#f85552"
	line-numbers-plus-style = "#8da101"
	line-numbers-zero-style = "#939f91"
	line-numbers-left-style = "#939f91"
	line-numbers-right-style = "#939f91"
	file-style = bold "#3a94c5"
	file-decoration-style = "#3a94c5" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#939f91" box
	hunk-header-file-style = "#df69ba"
	hunk-header-line-number-style = "#dfa000"
	commit-style = raw
	commit-decoration-style = "#dfa000" box
	blame-palette = "#f3ead3 #eae4ca"
	map-styles = bold purple => syntax "#ddd8be", bold cyan => syntax "#eae4ca"
