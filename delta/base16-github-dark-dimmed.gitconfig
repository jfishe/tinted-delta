; tinted-delta: Github Dark Dimmed (base16-github-dark-dimmed)
; Scheme author: Tinted Theming (https://github.com/tinted-theming)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#d1d7e0 bg=#0d1117 red=#f47067 green=#57ab5a
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#2f3742"
	plus-style = green
	plus-emph-style = bold green "#2f3742"
	minus-empty-line-marker-style = normal "#f47067"
	plus-empty-line-marker-style = normal "#57ab5a"
	line-numbers-minus-style = "#f47067"
	line-numbers-plus-style = "#57ab5a"
	line-numbers-zero-style = "#656c76"
	line-numbers-left-style = "#656c76"
	line-numbers-right-style = "#656c76"
	file-style = bold "#539bf5"
	file-decoration-style = "#539bf5" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#656c76" box
	hunk-header-file-style = "#b083f0"
	hunk-header-line-number-style = "#c69026"
	commit-style = raw
	commit-decoration-style = "#c69026" box
	blame-palette = "#0d1117 #151b23"
	map-styles = bold purple => syntax "#2f3742", bold cyan => syntax "#151b23"
