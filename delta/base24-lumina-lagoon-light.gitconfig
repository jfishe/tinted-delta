; tinted-delta: Lumina Lagoon Light (base24-lumina-lagoon-light)
; Scheme author: Razik Ikhlef (https://github.com/RazikSF)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#0b323b bg=#e9fafa red=#8f2121 green=#2e6147
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#d5e8e8"
	plus-style = green
	plus-emph-style = bold green "#d5e8e8"
	minus-empty-line-marker-style = normal "#8f2121"
	plus-empty-line-marker-style = normal "#2e6147"
	line-numbers-minus-style = "#8f2121"
	line-numbers-plus-style = "#2e6147"
	line-numbers-zero-style = "#c5d8d8"
	line-numbers-left-style = "#c5d8d8"
	line-numbers-right-style = "#c5d8d8"
	file-style = bold "#185ca9"
	file-decoration-style = "#185ca9" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#c5d8d8" box
	hunk-header-file-style = "#7153b5"
	hunk-header-line-number-style = "#a1600d"
	commit-style = raw
	commit-decoration-style = "#a1600d" box
	blame-palette = "#e9fafa #e1f4f4"
	map-styles = bold purple => syntax "#d5e8e8", bold cyan => syntax "#e1f4f4"
