; tinted-delta: Colors (base16-colors)
; Scheme author: mrmrs (http://clrs.cc)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#bbbbbb bg=#111111 red=#ff4136 green=#2ecc40
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#555555"
	plus-style = green
	plus-emph-style = bold green "#555555"
	minus-empty-line-marker-style = normal "#ff4136"
	plus-empty-line-marker-style = normal "#2ecc40"
	line-numbers-minus-style = "#ff4136"
	line-numbers-plus-style = "#2ecc40"
	line-numbers-zero-style = "#777777"
	line-numbers-left-style = "#777777"
	line-numbers-right-style = "#777777"
	file-style = bold "#0074d9"
	file-decoration-style = "#0074d9" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#777777" box
	hunk-header-file-style = "#b10dc9"
	hunk-header-line-number-style = "#ffdc00"
	commit-style = raw
	commit-decoration-style = "#ffdc00" box
	blame-palette = "#111111 #333333"
	map-styles = bold purple => syntax "#555555", bold cyan => syntax "#333333"
