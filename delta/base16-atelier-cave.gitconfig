; tinted-delta: Atelier Cave (base16-atelier-cave)
; Scheme author: Bram de Haan (http://atelierbramdehaan.nl)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#8b8792 bg=#19171c red=#be4678 green=#2a9292
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#585260"
	plus-style = green
	plus-emph-style = bold green "#585260"
	minus-empty-line-marker-style = normal "#be4678"
	plus-empty-line-marker-style = normal "#2a9292"
	line-numbers-minus-style = "#be4678"
	line-numbers-plus-style = "#2a9292"
	line-numbers-zero-style = "#655f6d"
	line-numbers-left-style = "#655f6d"
	line-numbers-right-style = "#655f6d"
	file-style = bold "#576ddb"
	file-decoration-style = "#576ddb" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#655f6d" box
	hunk-header-file-style = "#955ae7"
	hunk-header-line-number-style = "#a06e3b"
	commit-style = raw
	commit-decoration-style = "#a06e3b" box
	blame-palette = "#19171c #26232a"
	map-styles = bold purple => syntax "#585260", bold cyan => syntax "#26232a"
