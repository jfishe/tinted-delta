; tinted-delta: Github Light Colorblind (base16-github-light-colorblind)
; Scheme author: Tinted Theming (https://github.com/tinted-theming)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#454c54 bg=#ffffff red=#bc4c00 green=#0550ae
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#d1d9e0"
	plus-style = green
	plus-emph-style = bold green "#d1d9e0"
	minus-empty-line-marker-style = normal "#bc4c00"
	plus-empty-line-marker-style = normal "#0550ae"
	line-numbers-minus-style = "#bc4c00"
	line-numbers-plus-style = "#0550ae"
	line-numbers-zero-style = "#818b98"
	line-numbers-left-style = "#818b98"
	line-numbers-right-style = "#818b98"
	file-style = bold "#0969da"
	file-decoration-style = "#0969da" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#818b98" box
	hunk-header-file-style = "#8250df"
	hunk-header-line-number-style = "#9a6700"
	commit-style = raw
	commit-decoration-style = "#9a6700" box
	blame-palette = "#ffffff #f6f8fa"
	map-styles = bold purple => syntax "#d1d9e0", bold cyan => syntax "#f6f8fa"
