; tinted-delta: Idea (base24-idea)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#515151 bg=#202020 red=#fb5255 green=#98b61b
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#fffefe"
	plus-style = green
	plus-emph-style = bold green "#fffefe"
	minus-empty-line-marker-style = normal "#fb5255"
	plus-empty-line-marker-style = normal "#98b61b"
	line-numbers-minus-style = "#fb5255"
	line-numbers-plus-style = "#98b61b"
	line-numbers-zero-style = "#c5c5c5"
	line-numbers-left-style = "#c5c5c5"
	line-numbers-right-style = "#c5c5c5"
	file-style = bold "#437ee6"
	file-decoration-style = "#437ee6" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#c5c5c5" box
	hunk-header-file-style = "#9d73b0"
	hunk-header-line-number-style = "#6c9bed"
	commit-style = raw
	commit-decoration-style = "#6c9bed" box
	blame-palette = "#202020 #acacac"
	map-styles = bold purple => syntax "#fffefe", bold cyan => syntax "#acacac"
