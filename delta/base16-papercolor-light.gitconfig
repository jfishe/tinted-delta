; tinted-delta: PaperColor Light (base16-papercolor-light)
; Scheme author: Jon Leopard (http://github.com/jonleopard), Tinted Theming (https://github.com/tinted-theming), based on PaperColor Theme (https://github.com/NLKNguyen/papercolor-theme)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#5e5e5e bg=#eeeeee red=#d70000 green=#008700
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#9e9e9e"
	plus-style = green
	plus-emph-style = bold green "#9e9e9e"
	minus-empty-line-marker-style = normal "#d70000"
	plus-empty-line-marker-style = normal "#008700"
	line-numbers-minus-style = "#d70000"
	line-numbers-plus-style = "#008700"
	line-numbers-zero-style = "#858585"
	line-numbers-left-style = "#858585"
	line-numbers-right-style = "#858585"
	file-style = bold "#005f87"
	file-decoration-style = "#005f87" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#858585" box
	hunk-header-file-style = "#8700af"
	hunk-header-line-number-style = "#d75f00"
	commit-style = raw
	commit-decoration-style = "#d75f00" box
	blame-palette = "#eeeeee #c4c4c4"
	map-styles = bold purple => syntax "#9e9e9e", bold cyan => syntax "#c4c4c4"
