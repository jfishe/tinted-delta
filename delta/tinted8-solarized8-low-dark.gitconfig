; tinted-delta: Solarized 8 Low Contrast Dark (tinted8-solarized8-low-dark)
; Scheme author: jfishe (generated by colortemplate2tinty)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#839496 bg=#073642 red=#dc322f green=#859900
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#586e75"
	plus-style = green
	plus-emph-style = bold green "#586e75"
	minus-empty-line-marker-style = normal "#dc322f"
	plus-empty-line-marker-style = normal "#859900"
	line-numbers-minus-style = "#dc322f"
	line-numbers-plus-style = "#859900"
	line-numbers-zero-style = "#586e75"
	line-numbers-left-style = "#586e75"
	line-numbers-right-style = "#586e75"
	file-style = bold "#268bd2"
	file-decoration-style = "#268bd2" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#586e75" box
	hunk-header-file-style = "#d33682"
	hunk-header-line-number-style = "#b58900"
	commit-style = raw
	commit-decoration-style = "#b58900" box
	blame-palette = "#073642 #073642"
	map-styles = bold purple => syntax "#586e75", bold cyan => syntax "#073642"
