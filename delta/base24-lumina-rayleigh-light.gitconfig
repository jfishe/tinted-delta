; tinted-delta: Lumina Rayleigh Light (base24-lumina-rayleigh-light)
; Scheme author: Razik Ikhlef (https://github.com/RazikSF)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#1d2f47 bg=#edf8ff red=#94171b green=#1e773b
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#d8e6f0"
	plus-style = green
	plus-emph-style = bold green "#d8e6f0"
	minus-empty-line-marker-style = normal "#94171b"
	plus-empty-line-marker-style = normal "#1e773b"
	line-numbers-minus-style = "#94171b"
	line-numbers-plus-style = "#1e773b"
	line-numbers-zero-style = "#c8d6df"
	line-numbers-left-style = "#c8d6df"
	line-numbers-right-style = "#c8d6df"
	file-style = bold "#0160a7"
	file-decoration-style = "#0160a7" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#c8d6df" box
	hunk-header-file-style = "#7244a9"
	hunk-header-line-number-style = "#a35f00"
	commit-style = raw
	commit-decoration-style = "#a35f00" box
	blame-palette = "#edf8ff #e3f2fb"
	map-styles = bold purple => syntax "#d8e6f0", bold cyan => syntax "#e3f2fb"
