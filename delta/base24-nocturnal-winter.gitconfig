; tinted-delta: Nocturnal Winter (base24-nocturnal-winter)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#dcdcdc bg=#0d0d17 red=#f12d52 green=#08cd7d
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#7f7f7f"
	plus-style = green
	plus-emph-style = bold green "#7f7f7f"
	minus-empty-line-marker-style = normal "#f12d52"
	plus-empty-line-marker-style = normal "#08cd7d"
	line-numbers-minus-style = "#f12d52"
	line-numbers-plus-style = "#08cd7d"
	line-numbers-zero-style = "#9e9e9e"
	line-numbers-left-style = "#9e9e9e"
	line-numbers-right-style = "#9e9e9e"
	file-style = bold "#3081df"
	file-decoration-style = "#3081df" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#9e9e9e" box
	hunk-header-file-style = "#fe2a6c"
	hunk-header-line-number-style = "#6095fe"
	commit-style = raw
	commit-decoration-style = "#6095fe" box
	blame-palette = "#0d0d17 #4c4c4c"
	map-styles = bold purple => syntax "#7f7f7f", bold cyan => syntax "#4c4c4c"
