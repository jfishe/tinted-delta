; tinted-delta: Grayscale Light (base16-grayscale-light)
; Scheme author: Alexandre Gavioli (https://github.com/Alexx2/)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#464646 bg=#f7f7f7 red=#7c7c7c green=#8e8e8e
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#b9b9b9"
	plus-style = green
	plus-emph-style = bold green "#b9b9b9"
	minus-empty-line-marker-style = normal "#7c7c7c"
	plus-empty-line-marker-style = normal "#8e8e8e"
	line-numbers-minus-style = "#7c7c7c"
	line-numbers-plus-style = "#8e8e8e"
	line-numbers-zero-style = "#ababab"
	line-numbers-left-style = "#ababab"
	line-numbers-right-style = "#ababab"
	file-style = bold "#686868"
	file-decoration-style = "#686868" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#ababab" box
	hunk-header-file-style = "#747474"
	hunk-header-line-number-style = "#a0a0a0"
	commit-style = raw
	commit-decoration-style = "#a0a0a0" box
	blame-palette = "#f7f7f7 #e3e3e3"
	map-styles = bold purple => syntax "#b9b9b9", bold cyan => syntax "#e3e3e3"
