; tinted-delta: Lumina Dusk Light (base24-lumina-dusk-light)
; Scheme author: Razik Ikhlef (https://github.com/RazikSF)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#2e2945 bg=#f6f3fe red=#872423 green=#357545
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#e4e0ef"
	plus-style = green
	plus-emph-style = bold green "#e4e0ef"
	minus-empty-line-marker-style = normal "#872423"
	plus-empty-line-marker-style = normal "#357545"
	line-numbers-minus-style = "#872423"
	line-numbers-plus-style = "#357545"
	line-numbers-zero-style = "#d4d0de"
	line-numbers-left-style = "#d4d0de"
	line-numbers-right-style = "#d4d0de"
	file-style = bold "#3163ad"
	file-decoration-style = "#3163ad" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#d4d0de" box
	hunk-header-file-style = "#7b46a4"
	hunk-header-line-number-style = "#9e611b"
	commit-style = raw
	commit-decoration-style = "#9e611b" box
	blame-palette = "#f6f3fe #f0ecfa"
	map-styles = bold purple => syntax "#e4e0ef", bold cyan => syntax "#f0ecfa"
