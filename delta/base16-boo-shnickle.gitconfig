; tinted-delta: boo-shnickle (base16-boo-shnickle)
; Scheme author: boo-shnickle (@boo_shnickle)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#bdbd97 bg=#191914 red=#ffbfa5 green=#e7ff99
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#5b5b49"
	plus-style = green
	plus-emph-style = bold green "#5b5b49"
	minus-empty-line-marker-style = normal "#ffbfa5"
	plus-empty-line-marker-style = normal "#e7ff99"
	line-numbers-minus-style = "#ffbfa5"
	line-numbers-plus-style = "#e7ff99"
	line-numbers-zero-style = "#7c7c63"
	line-numbers-left-style = "#7c7c63"
	line-numbers-right-style = "#7c7c63"
	file-style = bold "#bfbfd9"
	file-decoration-style = "#bfbfd9" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#7c7c63" box
	hunk-header-file-style = "#f2bfd9"
	hunk-header-line-number-style = "#fff299"
	commit-style = raw
	commit-decoration-style = "#fff299" box
	blame-palette = "#191914 #3a3a2e"
	map-styles = bold purple => syntax "#5b5b49", bold cyan => syntax "#3a3a2e"
