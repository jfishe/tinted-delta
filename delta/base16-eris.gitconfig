; tinted-delta: eris (base16-eris)
; Scheme author: ed (https://codeberg.org/ed), Tinted Theming (https://github.com/tinted-theming)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#606bac bg=#0a0920 red=#f768a3 green=#a2faa8
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#23255a"
	plus-style = green
	plus-emph-style = bold green "#23255a"
	minus-empty-line-marker-style = normal "#f768a3"
	plus-empty-line-marker-style = normal "#a2faa8"
	line-numbers-minus-style = "#f768a3"
	line-numbers-plus-style = "#a2faa8"
	line-numbers-zero-style = "#333773"
	line-numbers-left-style = "#333773"
	line-numbers-right-style = "#333773"
	file-style = bold "#258fc4"
	file-decoration-style = "#258fc4" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#333773" box
	hunk-header-file-style = "#c368f7"
	hunk-header-line-number-style = "#f7d668"
	commit-style = raw
	commit-decoration-style = "#f7d668" box
	blame-palette = "#0a0920 #13133a"
	map-styles = bold purple => syntax "#23255a", bold cyan => syntax "#13133a"
