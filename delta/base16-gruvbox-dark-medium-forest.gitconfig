; tinted-delta: Gruvbox Dark Medium (Forest) (base16-gruvbox-dark-medium-forest)
; Scheme author: Muhammad Talha (muhammadtalha.quant@gmail.com), morhetz (https://github.com/morhetz/gruvbox)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#d5c4a1 bg=#282828 red=#fb4934 green=#b8bb26
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#504945"
	plus-style = green
	plus-emph-style = bold green "#504945"
	minus-empty-line-marker-style = normal "#fb4934"
	plus-empty-line-marker-style = normal "#b8bb26"
	line-numbers-minus-style = "#fb4934"
	line-numbers-plus-style = "#b8bb26"
	line-numbers-zero-style = "#665c50"
	line-numbers-left-style = "#665c50"
	line-numbers-right-style = "#665c50"
	file-style = bold "#b8bb26"
	file-decoration-style = "#b8bb26" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#665c50" box
	hunk-header-file-style = "#96bda2"
	hunk-header-line-number-style = "#fabd2f"
	commit-style = raw
	commit-decoration-style = "#fabd2f" box
	blame-palette = "#282828 #3c3836"
	map-styles = bold purple => syntax "#504945", bold cyan => syntax "#3c3836"
