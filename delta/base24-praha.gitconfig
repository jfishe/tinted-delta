; tinted-delta: Praha (base24-praha)
; Scheme author: xscriptor (https://github.com/xscriptor)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#ffffff bg=#1a1a1a red=#ff5555 green=#b8e6a0
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#353535"
	plus-style = green
	plus-emph-style = bold green "#353535"
	minus-empty-line-marker-style = normal "#ff5555"
	plus-empty-line-marker-style = normal "#b8e6a0"
	line-numbers-minus-style = "#ff5555"
	line-numbers-plus-style = "#b8e6a0"
	line-numbers-zero-style = "#6272a4"
	line-numbers-left-style = "#6272a4"
	line-numbers-right-style = "#6272a4"
	file-style = bold "#bd93f9"
	file-decoration-style = "#bd93f9" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#6272a4" box
	hunk-header-file-style = "#ff9aa2"
	hunk-header-line-number-style = "#ffe4a3"
	commit-style = raw
	commit-decoration-style = "#ffe4a3" box
	blame-palette = "#1a1a1a #2a2a2a"
	map-styles = bold purple => syntax "#353535", bold cyan => syntax "#2a2a2a"
