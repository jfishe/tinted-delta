; tinted-delta: Atelier Dune (base16-atelier-dune)
; Scheme author: Bram de Haan (http://atelierbramdehaan.nl)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#a6a28c bg=#20201d red=#d73737 green=#60ac39
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#6e6b5e"
	plus-style = green
	plus-emph-style = bold green "#6e6b5e"
	minus-empty-line-marker-style = normal "#d73737"
	plus-empty-line-marker-style = normal "#60ac39"
	line-numbers-minus-style = "#d73737"
	line-numbers-plus-style = "#60ac39"
	line-numbers-zero-style = "#7d7a68"
	line-numbers-left-style = "#7d7a68"
	line-numbers-right-style = "#7d7a68"
	file-style = bold "#6684e1"
	file-decoration-style = "#6684e1" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#7d7a68" box
	hunk-header-file-style = "#b854d4"
	hunk-header-line-number-style = "#ae9513"
	commit-style = raw
	commit-decoration-style = "#ae9513" box
	blame-palette = "#20201d #292824"
	map-styles = bold purple => syntax "#6e6b5e", bold cyan => syntax "#292824"
