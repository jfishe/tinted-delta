; tinted-delta: Atelier Cave Light (base16-atelier-cave-light)
; Scheme author: Bram de Haan (http://atelierbramdehaan.nl)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#585260 bg=#efecf4 red=#be4678 green=#2a9292
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#8b8792"
	plus-style = green
	plus-emph-style = bold green "#8b8792"
	minus-empty-line-marker-style = normal "#be4678"
	plus-empty-line-marker-style = normal "#2a9292"
	line-numbers-minus-style = "#be4678"
	line-numbers-plus-style = "#2a9292"
	line-numbers-zero-style = "#7e7887"
	line-numbers-left-style = "#7e7887"
	line-numbers-right-style = "#7e7887"
	file-style = bold "#576ddb"
	file-decoration-style = "#576ddb" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#7e7887" box
	hunk-header-file-style = "#955ae7"
	hunk-header-line-number-style = "#a06e3b"
	commit-style = raw
	commit-decoration-style = "#a06e3b" box
	blame-palette = "#efecf4 #e2dfe7"
	map-styles = bold purple => syntax "#8b8792", bold cyan => syntax "#e2dfe7"
