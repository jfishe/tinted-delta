; tinted-delta: Da One Paper (base16-da-one-paper)
; Scheme author: NNB (https://github.com/NNBnh)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#181818 bg=#faf0dc red=#de5d6e green=#76a85d
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#888888"
	plus-style = green
	plus-emph-style = bold green "#888888"
	minus-empty-line-marker-style = normal "#de5d6e"
	plus-empty-line-marker-style = normal "#76a85d"
	line-numbers-minus-style = "#de5d6e"
	line-numbers-plus-style = "#76a85d"
	line-numbers-zero-style = "#585858"
	line-numbers-left-style = "#585858"
	line-numbers-right-style = "#585858"
	file-style = bold "#5890f8"
	file-decoration-style = "#5890f8" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#585858" box
	hunk-header-file-style = "#c173d1"
	hunk-header-line-number-style = "#b3684f"
	commit-style = raw
	commit-decoration-style = "#b3684f" box
	blame-palette = "#faf0dc #c8c8c8"
	map-styles = bold purple => syntax "#888888", bold cyan => syntax "#c8c8c8"
