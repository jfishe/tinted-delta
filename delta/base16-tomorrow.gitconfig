; tinted-delta: Tomorrow (base16-tomorrow)
; Scheme author: Chris Kempson (http://chriskempson.com)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#373b41 bg=#ffffff red=#c82829 green=#718c00
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#c5c8c6"
	plus-style = green
	plus-emph-style = bold green "#c5c8c6"
	minus-empty-line-marker-style = normal "#c82829"
	plus-empty-line-marker-style = normal "#718c00"
	line-numbers-minus-style = "#c82829"
	line-numbers-plus-style = "#718c00"
	line-numbers-zero-style = "#b4b7b4"
	line-numbers-left-style = "#b4b7b4"
	line-numbers-right-style = "#b4b7b4"
	file-style = bold "#4271ae"
	file-decoration-style = "#4271ae" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#b4b7b4" box
	hunk-header-file-style = "#8959a8"
	hunk-header-line-number-style = "#eab700"
	commit-style = raw
	commit-decoration-style = "#eab700" box
	blame-palette = "#ffffff #e0e0e0"
	map-styles = bold purple => syntax "#c5c8c6", bold cyan => syntax "#e0e0e0"
