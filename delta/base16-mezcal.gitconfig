; tinted-delta: Mezcal (base16-mezcal)
; Scheme author: Teshre
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#e0d8c8 bg=#13110e red=#da6e54 green=#a8b84a
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#36301e"
	plus-style = green
	plus-emph-style = bold green "#36301e"
	minus-empty-line-marker-style = normal "#da6e54"
	plus-empty-line-marker-style = normal "#a8b84a"
	line-numbers-minus-style = "#da6e54"
	line-numbers-plus-style = "#a8b84a"
	line-numbers-zero-style = "#6e6450"
	line-numbers-left-style = "#6e6450"
	line-numbers-right-style = "#6e6450"
	file-style = bold "#8aa6c0"
	file-decoration-style = "#8aa6c0" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#6e6450" box
	hunk-header-file-style = "#c28aa8"
	hunk-header-line-number-style = "#d9a441"
	commit-style = raw
	commit-decoration-style = "#d9a441" box
	blame-palette = "#13110e #221f14"
	map-styles = bold purple => syntax "#36301e", bold cyan => syntax "#221f14"
