; tinted-delta: Humanoid light (base16-humanoid-light)
; Scheme author: Thomas (tasmo) Friese
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#232629 bg=#f8f8f2 red=#b0151a green=#388e3c
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#deded8"
	plus-style = green
	plus-emph-style = bold green "#deded8"
	minus-empty-line-marker-style = normal "#b0151a"
	plus-empty-line-marker-style = normal "#388e3c"
	line-numbers-minus-style = "#b0151a"
	line-numbers-plus-style = "#388e3c"
	line-numbers-zero-style = "#c0c0bd"
	line-numbers-left-style = "#c0c0bd"
	line-numbers-right-style = "#c0c0bd"
	file-style = bold "#0082c9"
	file-decoration-style = "#0082c9" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#c0c0bd" box
	hunk-header-file-style = "#700f98"
	hunk-header-line-number-style = "#ffb627"
	commit-style = raw
	commit-decoration-style = "#ffb627" box
	blame-palette = "#f8f8f2 #efefe9"
	map-styles = bold purple => syntax "#deded8", bold cyan => syntax "#efefe9"
