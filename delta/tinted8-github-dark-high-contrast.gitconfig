; tinted-delta: Github Dark High Contrast (tinted8-github-dark-high-contrast)
; Scheme author: Tinted Theming (https://github.com/tinted-theming)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#ffffff bg=#010409 red=#ff9492 green=#28d751
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#656c76"
	plus-style = green
	plus-emph-style = bold green "#656c76"
	minus-empty-line-marker-style = normal "#ff9492"
	plus-empty-line-marker-style = normal "#28d751"
	line-numbers-minus-style = "#ff9492"
	line-numbers-plus-style = "#28d751"
	line-numbers-zero-style = "#656c76"
	line-numbers-left-style = "#656c76"
	line-numbers-right-style = "#656c76"
	file-style = bold "#71b7ff"
	file-decoration-style = "#71b7ff" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#656c76" box
	hunk-header-file-style = "#cb9eff"
	hunk-header-line-number-style = "#f0b72f"
	commit-style = raw
	commit-decoration-style = "#f0b72f" box
	blame-palette = "#010409 #151b23"
	map-styles = bold purple => syntax "#656c76", bold cyan => syntax "#484e55"
