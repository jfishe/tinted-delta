; tinted-delta: Yesterday Night (base16-yesterday-night)
; Scheme author: FroZnShiva (https://github.com/FroZnShiva)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#dfe1e8 bg=#343d46 red=#cc6666 green=#b5bd68
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#65737e"
	plus-style = green
	plus-emph-style = bold green "#65737e"
	minus-empty-line-marker-style = normal "#cc6666"
	plus-empty-line-marker-style = normal "#b5bd68"
	line-numbers-minus-style = "#cc6666"
	line-numbers-plus-style = "#b5bd68"
	line-numbers-zero-style = "#a7adba"
	line-numbers-left-style = "#a7adba"
	line-numbers-right-style = "#a7adba"
	file-style = bold "#81a2be"
	file-decoration-style = "#81a2be" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#a7adba" box
	hunk-header-file-style = "#b294bb"
	hunk-header-line-number-style = "#f0c674"
	commit-style = raw
	commit-decoration-style = "#f0c674" box
	blame-palette = "#343d46 #4f5b66"
	map-styles = bold purple => syntax "#65737e", bold cyan => syntax "#4f5b66"
