; tinted-delta: Lumina Oxblood Dark (base24-lumina-oxblood-dark)
; Scheme author: Razik Ikhlef (https://github.com/RazikSF)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#e8d6dc bg=#200f16 red=#db6c63 green=#7dc797
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#301c24"
	plus-style = green
	plus-emph-style = bold green "#301c24"
	minus-empty-line-marker-style = normal "#db6c63"
	plus-empty-line-marker-style = normal "#7dc797"
	line-numbers-minus-style = "#db6c63"
	line-numbers-plus-style = "#7dc797"
	line-numbers-zero-style = "#3b262e"
	line-numbers-left-style = "#3b262e"
	line-numbers-right-style = "#3b262e"
	file-style = bold "#9ac3f8"
	file-decoration-style = "#9ac3f8" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#3b262e" box
	hunk-header-file-style = "#bfb6f9"
	hunk-header-line-number-style = "#f9c875"
	commit-style = raw
	commit-decoration-style = "#f9c875" box
	blame-palette = "#200f16 #26131b"
	map-styles = bold purple => syntax "#301c24", bold cyan => syntax "#26131b"
