; tinted-delta: Bosque (base16-bosque)
; Scheme author: Teshre
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#cfe5d2 bg=#0e1410 red=#e2706a green=#6fc56e
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#1e3023"
	plus-style = green
	plus-emph-style = bold green "#1e3023"
	minus-empty-line-marker-style = normal "#e2706a"
	plus-empty-line-marker-style = normal "#6fc56e"
	line-numbers-minus-style = "#e2706a"
	line-numbers-plus-style = "#6fc56e"
	line-numbers-zero-style = "#5c6e5e"
	line-numbers-left-style = "#5c6e5e"
	line-numbers-right-style = "#5c6e5e"
	file-style = bold "#6dae9e"
	file-decoration-style = "#6dae9e" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#5c6e5e" box
	hunk-header-file-style = "#b894d0"
	hunk-header-line-number-style = "#c8b84a"
	commit-style = raw
	commit-decoration-style = "#c8b84a" box
	blame-palette = "#0e1410 #16211a"
	map-styles = bold purple => syntax "#1e3023", bold cyan => syntax "#16211a"
