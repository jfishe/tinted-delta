; tinted-delta: Edge Light (base16-edge-light)
; Scheme author: cjayross (https://github.com/cjayross), Tinted Theming (https://github.com/tinted-theming)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#474752 bg=#fafafa red=#db7070 green=#7c9f4b
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#acb1b9"
	plus-style = green
	plus-emph-style = bold green "#acb1b9"
	minus-empty-line-marker-style = normal "#db7070"
	plus-empty-line-marker-style = normal "#7c9f4b"
	line-numbers-minus-style = "#db7070"
	line-numbers-plus-style = "#7c9f4b"
	line-numbers-zero-style = "#9197a1"
	line-numbers-left-style = "#9197a1"
	line-numbers-right-style = "#9197a1"
	file-style = bold "#6587bf"
	file-decoration-style = "#6587bf" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#9197a1" box
	hunk-header-file-style = "#b870ce"
	hunk-header-line-number-style = "#ebcc1a"
	commit-style = raw
	commit-decoration-style = "#ebcc1a" box
	blame-palette = "#fafafa #e3e5e8"
	map-styles = bold purple => syntax "#acb1b9", bold cyan => syntax "#e3e5e8"
