; tinted-delta: Papel (base16-papel)
; Scheme author: Teshre
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#3a2e20 bg=#f5efe2 red=#c0392b green=#5e7a28
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#e0d0ac"
	plus-style = green
	plus-emph-style = bold green "#e0d0ac"
	minus-empty-line-marker-style = normal "#c0392b"
	plus-empty-line-marker-style = normal "#5e7a28"
	line-numbers-minus-style = "#c0392b"
	line-numbers-plus-style = "#5e7a28"
	line-numbers-zero-style = "#9a8c76"
	line-numbers-left-style = "#9a8c76"
	line-numbers-right-style = "#9a8c76"
	file-style = bold "#2c6ca0"
	file-decoration-style = "#2c6ca0" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#9a8c76" box
	hunk-header-file-style = "#9b4d8e"
	hunk-header-line-number-style = "#a8761a"
	commit-style = raw
	commit-decoration-style = "#a8761a" box
	blame-palette = "#f5efe2 #8e8576"
	map-styles = bold purple => syntax "#e0d0ac", bold cyan => syntax "#8e8576"
