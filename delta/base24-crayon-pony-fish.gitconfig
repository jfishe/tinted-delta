; tinted-delta: Crayon Pony Fish (base24-crayon-pony-fish)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#5d484e bg=#140607 red=#90002a green=#579523
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#3c2a2e"
	plus-style = green
	plus-emph-style = bold green "#3c2a2e"
	minus-empty-line-marker-style = normal "#90002a"
	plus-empty-line-marker-style = normal "#579523"
	line-numbers-minus-style = "#90002a"
	line-numbers-plus-style = "#579523"
	line-numbers-zero-style = "#473438"
	line-numbers-left-style = "#473438"
	line-numbers-right-style = "#473438"
	file-style = bold "#8b87af"
	file-decoration-style = "#8b87af" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#473438" box
	hunk-header-file-style = "#682e50"
	hunk-header-line-number-style = "#cfc9ff"
	commit-style = raw
	commit-decoration-style = "#cfc9ff" box
	blame-palette = "#140607 #2a1a1c"
	map-styles = bold purple => syntax "#3c2a2e", bold cyan => syntax "#2a1a1c"
