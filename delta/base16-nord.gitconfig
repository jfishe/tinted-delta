; tinted-delta: Nord (base16-nord)
; Scheme author: arcticicestudio
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#e5e9f0 bg=#2e3440 red=#bf616a green=#a3be8c
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#434c5e"
	plus-style = green
	plus-emph-style = bold green "#434c5e"
	minus-empty-line-marker-style = normal "#bf616a"
	plus-empty-line-marker-style = normal "#a3be8c"
	line-numbers-minus-style = "#bf616a"
	line-numbers-plus-style = "#a3be8c"
	line-numbers-zero-style = "#4c566a"
	line-numbers-left-style = "#4c566a"
	line-numbers-right-style = "#4c566a"
	file-style = bold "#81a1c1"
	file-decoration-style = "#81a1c1" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#4c566a" box
	hunk-header-file-style = "#b48ead"
	hunk-header-line-number-style = "#ebcb8b"
	commit-style = raw
	commit-decoration-style = "#ebcb8b" box
	blame-palette = "#2e3440 #3b4252"
	map-styles = bold purple => syntax "#434c5e", bold cyan => syntax "#3b4252"
