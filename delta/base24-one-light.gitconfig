; tinted-delta: One Light (base24-one-light)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#383a42 bg=#e7e7e9 red=#ca1243 green=#50a14f
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#cacace"
	plus-style = green
	plus-emph-style = bold green "#cacace"
	minus-empty-line-marker-style = normal "#ca1243"
	plus-empty-line-marker-style = normal "#50a14f"
	line-numbers-minus-style = "#ca1243"
	line-numbers-plus-style = "#50a14f"
	line-numbers-zero-style = "#a0a1a7"
	line-numbers-left-style = "#a0a1a7"
	line-numbers-right-style = "#a0a1a7"
	file-style = bold "#4078f2"
	file-decoration-style = "#4078f2" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#a0a1a7" box
	hunk-header-file-style = "#a626a4"
	hunk-header-line-number-style = "#febb2a"
	commit-style = raw
	commit-decoration-style = "#febb2a" box
	blame-palette = "#e7e7e9 #dfdfe1"
	map-styles = bold purple => syntax "#cacace", bold cyan => syntax "#dfdfe1"
