; tinted-delta: Hardcore (base16-hardcore)
; Scheme author: Chris Caller
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#cdcdcd bg=#212121 red=#f92672 green=#a6e22e
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#353535"
	plus-style = green
	plus-emph-style = bold green "#353535"
	minus-empty-line-marker-style = normal "#f92672"
	plus-empty-line-marker-style = normal "#a6e22e"
	line-numbers-minus-style = "#f92672"
	line-numbers-plus-style = "#a6e22e"
	line-numbers-zero-style = "#4a4a4a"
	line-numbers-left-style = "#4a4a4a"
	line-numbers-right-style = "#4a4a4a"
	file-style = bold "#66d9ef"
	file-decoration-style = "#66d9ef" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#4a4a4a" box
	hunk-header-file-style = "#9e6ffe"
	hunk-header-line-number-style = "#e6db74"
	commit-style = raw
	commit-decoration-style = "#e6db74" box
	blame-palette = "#212121 #303030"
	map-styles = bold purple => syntax "#353535", bold cyan => syntax "#303030"
