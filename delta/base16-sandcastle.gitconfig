; tinted-delta: Sandcastle (base16-sandcastle)
; Scheme author: George Essig (https://github.com/gessig)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#a89984 bg=#282c34 red=#83a598 green=#528b8b
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#3e4451"
	plus-style = green
	plus-emph-style = bold green "#3e4451"
	minus-empty-line-marker-style = normal "#83a598"
	plus-empty-line-marker-style = normal "#528b8b"
	line-numbers-minus-style = "#83a598"
	line-numbers-plus-style = "#528b8b"
	line-numbers-zero-style = "#665c54"
	line-numbers-left-style = "#665c54"
	line-numbers-right-style = "#665c54"
	file-style = bold "#83a598"
	file-decoration-style = "#83a598" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#665c54" box
	hunk-header-file-style = "#d75f5f"
	hunk-header-line-number-style = "#a07e3b"
	commit-style = raw
	commit-decoration-style = "#a07e3b" box
	blame-palette = "#282c34 #2c323b"
	map-styles = bold purple => syntax "#3e4451", bold cyan => syntax "#2c323b"
