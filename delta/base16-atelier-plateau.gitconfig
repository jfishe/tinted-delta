; tinted-delta: Atelier Plateau (base16-atelier-plateau)
; Scheme author: Bram de Haan (http://atelierbramdehaan.nl)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#8a8585 bg=#1b1818 red=#ca4949 green=#4b8b8b
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#585050"
	plus-style = green
	plus-emph-style = bold green "#585050"
	minus-empty-line-marker-style = normal "#ca4949"
	plus-empty-line-marker-style = normal "#4b8b8b"
	line-numbers-minus-style = "#ca4949"
	line-numbers-plus-style = "#4b8b8b"
	line-numbers-zero-style = "#655d5d"
	line-numbers-left-style = "#655d5d"
	line-numbers-right-style = "#655d5d"
	file-style = bold "#7272ca"
	file-decoration-style = "#7272ca" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#655d5d" box
	hunk-header-file-style = "#8464c4"
	hunk-header-line-number-style = "#a06e3b"
	commit-style = raw
	commit-decoration-style = "#a06e3b" box
	blame-palette = "#1b1818 #292424"
	map-styles = bold purple => syntax "#585050", bold cyan => syntax "#292424"
