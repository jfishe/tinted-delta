; tinted-delta: Jet Brains Darcula (base24-jet-brains-darcula)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#979797 bg=#202020 red=#fa5355 green=#126e00
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#555555"
	plus-style = green
	plus-emph-style = bold green "#555555"
	minus-empty-line-marker-style = normal "#fa5355"
	plus-empty-line-marker-style = normal "#126e00"
	line-numbers-minus-style = "#fa5355"
	line-numbers-plus-style = "#126e00"
	line-numbers-zero-style = "#6b6b6b"
	line-numbers-left-style = "#6b6b6b"
	line-numbers-right-style = "#6b6b6b"
	file-style = bold "#4581eb"
	file-decoration-style = "#4581eb" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#6b6b6b" box
	hunk-header-file-style = "#fa54ff"
	hunk-header-line-number-style = "#6d9df1"
	commit-style = raw
	commit-decoration-style = "#6d9df1" box
	blame-palette = "#202020 #000000"
	map-styles = bold purple => syntax "#555555", bold cyan => syntax "#000000"
