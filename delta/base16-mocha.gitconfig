; tinted-delta: Mocha (base16-mocha)
; Scheme author: Chris Kempson (http://chriskempson.com)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#d0c8c6 bg=#3b3228 red=#cb6077 green=#beb55b
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#645240"
	plus-style = green
	plus-emph-style = bold green "#645240"
	minus-empty-line-marker-style = normal "#cb6077"
	plus-empty-line-marker-style = normal "#beb55b"
	line-numbers-minus-style = "#cb6077"
	line-numbers-plus-style = "#beb55b"
	line-numbers-zero-style = "#7e705a"
	line-numbers-left-style = "#7e705a"
	line-numbers-right-style = "#7e705a"
	file-style = bold "#8ab3b5"
	file-decoration-style = "#8ab3b5" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#7e705a" box
	hunk-header-file-style = "#a89bb9"
	hunk-header-line-number-style = "#f4bc87"
	commit-style = raw
	commit-decoration-style = "#f4bc87" box
	blame-palette = "#3b3228 #534636"
	map-styles = bold purple => syntax "#645240", bold cyan => syntax "#534636"
