; tinted-delta: Oxocarbon Dark (base16-oxocarbon-dark)
; Scheme author: shaunsingh/IBM, Tinted Theming (https://github.com/tinted-theming)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#f2f4f8 bg=#161616 red=#ee5396 green=#42be65
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#393939"
	plus-style = green
	plus-emph-style = bold green "#393939"
	minus-empty-line-marker-style = normal "#ee5396"
	plus-empty-line-marker-style = normal "#42be65"
	line-numbers-minus-style = "#ee5396"
	line-numbers-plus-style = "#42be65"
	line-numbers-zero-style = "#525252"
	line-numbers-left-style = "#525252"
	line-numbers-right-style = "#525252"
	file-style = bold "#33b1ff"
	file-decoration-style = "#33b1ff" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#525252" box
	hunk-header-file-style = "#be95ff"
	hunk-header-line-number-style = "#ff6f00"
	commit-style = raw
	commit-decoration-style = "#ff6f00" box
	blame-palette = "#161616 #262626"
	map-styles = bold purple => syntax "#393939", bold cyan => syntax "#262626"
