; tinted-delta: Railscasts (base16-railscasts)
; Scheme author: Ryan Bates (http://railscasts.com)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#e6e1dc bg=#2b2b2b red=#da4939 green=#a5c261
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#3a4055"
	plus-style = green
	plus-emph-style = bold green "#3a4055"
	minus-empty-line-marker-style = normal "#da4939"
	plus-empty-line-marker-style = normal "#a5c261"
	line-numbers-minus-style = "#da4939"
	line-numbers-plus-style = "#a5c261"
	line-numbers-zero-style = "#5a647e"
	line-numbers-left-style = "#5a647e"
	line-numbers-right-style = "#5a647e"
	file-style = bold "#6d9cbe"
	file-decoration-style = "#6d9cbe" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#5a647e" box
	hunk-header-file-style = "#b6b3eb"
	hunk-header-line-number-style = "#ffc66d"
	commit-style = raw
	commit-decoration-style = "#ffc66d" box
	blame-palette = "#2b2b2b #272935"
	map-styles = bold purple => syntax "#3a4055", bold cyan => syntax "#272935"
