; tinted-delta: Wombat (base24-wombat)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#b2afa6 bg=#171717 red=#ff605a green=#b1e869
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#313131"
	plus-style = green
	plus-emph-style = bold green "#313131"
	minus-empty-line-marker-style = normal "#ff605a"
	plus-empty-line-marker-style = normal "#b1e869"
	line-numbers-minus-style = "#ff605a"
	line-numbers-plus-style = "#b1e869"
	line-numbers-zero-style = "#5c5b58"
	line-numbers-left-style = "#5c5b58"
	line-numbers-right-style = "#5c5b58"
	file-style = bold "#5da9f6"
	file-decoration-style = "#5da9f6" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#5c5b58" box
	hunk-header-file-style = "#e86aff"
	hunk-header-line-number-style = "#a5c7ff"
	commit-style = raw
	commit-decoration-style = "#a5c7ff" box
	blame-palette = "#171717 #000000"
	map-styles = bold purple => syntax "#313131", bold cyan => syntax "#000000"
