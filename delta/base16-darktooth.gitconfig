; tinted-delta: Darktooth (base16-darktooth)
; Scheme author: Jason Milkins (https://github.com/jasonm23)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#a89984 bg=#1d2021 red=#fb543f green=#95c085
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#504945"
	plus-style = green
	plus-emph-style = bold green "#504945"
	minus-empty-line-marker-style = normal "#fb543f"
	plus-empty-line-marker-style = normal "#95c085"
	line-numbers-minus-style = "#fb543f"
	line-numbers-plus-style = "#95c085"
	line-numbers-zero-style = "#665c54"
	line-numbers-left-style = "#665c54"
	line-numbers-right-style = "#665c54"
	file-style = bold "#0d6678"
	file-decoration-style = "#0d6678" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#665c54" box
	hunk-header-file-style = "#8f4673"
	hunk-header-line-number-style = "#fac03b"
	commit-style = raw
	commit-decoration-style = "#fac03b" box
	blame-palette = "#1d2021 #32302f"
	map-styles = bold purple => syntax "#504945", bold cyan => syntax "#32302f"
