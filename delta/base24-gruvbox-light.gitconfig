; tinted-delta: Gruvbox Light (base24-gruvbox-light)
; Scheme author: Tinted Theming (https://github.com/tinted-theming), morhetz (https://github.com/morhetz/gruvbox)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#3c3836 bg=#fbf1c7 red=#cc241d green=#98971a
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#d5c4a1"
	plus-style = green
	plus-emph-style = bold green "#d5c4a1"
	minus-empty-line-marker-style = normal "#cc241d"
	plus-empty-line-marker-style = normal "#98971a"
	line-numbers-minus-style = "#cc241d"
	line-numbers-plus-style = "#98971a"
	line-numbers-zero-style = "#bdae93"
	line-numbers-left-style = "#bdae93"
	line-numbers-right-style = "#bdae93"
	file-style = bold "#458588"
	file-decoration-style = "#458588" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#bdae93" box
	hunk-header-file-style = "#b16286"
	hunk-header-line-number-style = "#d79921"
	commit-style = raw
	commit-decoration-style = "#d79921" box
	blame-palette = "#fbf1c7 #ebdbb2"
	map-styles = bold purple => syntax "#d5c4a1", bold cyan => syntax "#ebdbb2"
