; tinted-delta: Hybrid (base24-hybrid)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#8f9190 bg=#161718 red=#b74d50 green=#b3be5a
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#1d1e21"
	plus-style = green
	plus-emph-style = bold green "#1d1e21"
	minus-empty-line-marker-style = normal "#b74d50"
	plus-empty-line-marker-style = normal "#b3be5a"
	line-numbers-minus-style = "#b74d50"
	line-numbers-plus-style = "#b3be5a"
	line-numbers-zero-style = "#434446"
	line-numbers-left-style = "#434446"
	line-numbers-right-style = "#434446"
	file-style = bold "#6d90b0"
	file-decoration-style = "#6d90b0" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#434446" box
	hunk-header-file-style = "#a07eab"
	hunk-header-line-number-style = "#4b6b88"
	commit-style = raw
	commit-decoration-style = "#4b6b88" box
	blame-palette = "#161718 #2a2e33"
	map-styles = bold purple => syntax "#1d1e21", bold cyan => syntax "#2a2e33"
