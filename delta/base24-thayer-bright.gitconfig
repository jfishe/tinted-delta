; tinted-delta: Thayer Bright (base24-thayer-bright)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#adada9 bg=#1b1d1e red=#f92672 green=#4df740
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#505354"
	plus-style = green
	plus-emph-style = bold green "#505354"
	minus-empty-line-marker-style = normal "#f92672"
	plus-empty-line-marker-style = normal "#4df740"
	line-numbers-minus-style = "#f92672"
	line-numbers-plus-style = "#4df740"
	line-numbers-zero-style = "#6f7170"
	line-numbers-left-style = "#6f7170"
	line-numbers-right-style = "#6f7170"
	file-style = bold "#2656d6"
	file-decoration-style = "#2656d6" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#6f7170" box
	hunk-header-file-style = "#8c54fe"
	hunk-header-line-number-style = "#3f78ff"
	commit-style = raw
	commit-decoration-style = "#3f78ff" box
	blame-palette = "#1b1d1e #1b1d1e"
	map-styles = bold purple => syntax "#505354", bold cyan => syntax "#1b1d1e"
