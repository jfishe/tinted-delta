; tinted-delta: Primer Dark Dimmed (base16-primer-dark-dimmed)
; Scheme author: Jimmy Lin
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#909dab bg=#1c2128 red=#f47067 green=#57ab5a
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#444c56"
	plus-style = green
	plus-emph-style = bold green "#444c56"
	minus-empty-line-marker-style = normal "#f47067"
	plus-empty-line-marker-style = normal "#57ab5a"
	line-numbers-minus-style = "#f47067"
	line-numbers-plus-style = "#57ab5a"
	line-numbers-zero-style = "#545d68"
	line-numbers-left-style = "#545d68"
	line-numbers-right-style = "#545d68"
	file-style = bold "#539bf5"
	file-decoration-style = "#539bf5" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#545d68" box
	hunk-header-file-style = "#e275ad"
	hunk-header-line-number-style = "#c69026"
	commit-style = raw
	commit-decoration-style = "#c69026" box
	blame-palette = "#1c2128 #373e47"
	map-styles = bold purple => syntax "#444c56", bold cyan => syntax "#373e47"
