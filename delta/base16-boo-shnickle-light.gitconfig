; tinted-delta: boo-shnickle-light (base16-boo-shnickle-light)
; Scheme author: boo-shnickle (@boo_shnickle)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#5b5b49 bg=#ffffcc red=#ffbfa5 green=#e7ff99
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#bdbd97"
	plus-style = green
	plus-emph-style = bold green "#bdbd97"
	minus-empty-line-marker-style = normal "#ffbfa5"
	plus-empty-line-marker-style = normal "#e7ff99"
	line-numbers-minus-style = "#ffbfa5"
	line-numbers-plus-style = "#e7ff99"
	line-numbers-zero-style = "#9c9c7d"
	line-numbers-left-style = "#9c9c7d"
	line-numbers-right-style = "#9c9c7d"
	file-style = bold "#bfbfd9"
	file-decoration-style = "#bfbfd9" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#9c9c7d" box
	hunk-header-file-style = "#f2bfd9"
	hunk-header-line-number-style = "#fff299"
	commit-style = raw
	commit-decoration-style = "#fff299" box
	blame-palette = "#ffffcc #dedeb2"
	map-styles = bold purple => syntax "#bdbd97", bold cyan => syntax "#dedeb2"
