; tinted-delta: Breeze (base24-breeze)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#d3d7d8 bg=#31363b red=#ed1515 green=#11d116
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#7f8c8d"
	plus-style = green
	plus-emph-style = bold green "#7f8c8d"
	minus-empty-line-marker-style = normal "#ed1515"
	plus-empty-line-marker-style = normal "#11d116"
	line-numbers-minus-style = "#ed1515"
	line-numbers-plus-style = "#11d116"
	line-numbers-zero-style = "#9ba5a6"
	line-numbers-left-style = "#9ba5a6"
	line-numbers-right-style = "#9ba5a6"
	file-style = bold "#1d99f3"
	file-decoration-style = "#1d99f3" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#9ba5a6" box
	hunk-header-file-style = "#9b59b6"
	hunk-header-line-number-style = "#3daee9"
	commit-style = raw
	commit-decoration-style = "#3daee9" box
	blame-palette = "#31363b #31363b"
	map-styles = bold purple => syntax "#7f8c8d", bold cyan => syntax "#31363b"
