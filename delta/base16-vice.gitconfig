; tinted-delta: vice (base16-vice)
; Scheme author: Thomas Leon Highbaugh thighbaugh@zoho.com
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#8b9cbe bg=#17191e red=#ff29a8 green=#0badff
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#3c3f4c"
	plus-style = green
	plus-emph-style = bold green "#3c3f4c"
	minus-empty-line-marker-style = normal "#ff29a8"
	plus-empty-line-marker-style = normal "#0badff"
	line-numbers-minus-style = "#ff29a8"
	line-numbers-plus-style = "#0badff"
	line-numbers-zero-style = "#383a47"
	line-numbers-left-style = "#383a47"
	line-numbers-right-style = "#383a47"
	file-style = bold "#00eaff"
	file-decoration-style = "#00eaff" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#383a47" box
	hunk-header-file-style = "#00f6d9"
	hunk-header-line-number-style = "#f0ffaa"
	commit-style = raw
	commit-decoration-style = "#f0ffaa" box
	blame-palette = "#17191e #22262d"
	map-styles = bold purple => syntax "#3c3f4c", bold cyan => syntax "#22262d"
