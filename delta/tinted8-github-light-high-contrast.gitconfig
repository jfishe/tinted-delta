; tinted-delta: Github Light High Contrast (tinted8-github-light-high-contrast)
; Scheme author: Tinted Theming (https://github.com/tinted-theming)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#010409 bg=#ffffff red=#a0111f green=#024c1a
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#3d454c"
	plus-style = green
	plus-emph-style = bold green "#3d454c"
	minus-empty-line-marker-style = normal "#a0111f"
	plus-empty-line-marker-style = normal "#024c1a"
	line-numbers-minus-style = "#a0111f"
	line-numbers-plus-style = "#024c1a"
	line-numbers-zero-style = "#59636e"
	line-numbers-left-style = "#59636e"
	line-numbers-right-style = "#59636e"
	file-style = bold "#0349b4"
	file-decoration-style = "#0349b4" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#59636e" box
	hunk-header-file-style = "#622cbc"
	hunk-header-line-number-style = "#3f2200"
	commit-style = raw
	commit-decoration-style = "#3f2200" box
	blame-palette = "#ffffff #e6eaef"
	map-styles = bold purple => syntax "#3d454c", bold cyan => syntax "#3d454c"
