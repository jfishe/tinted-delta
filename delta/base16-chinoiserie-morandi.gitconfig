; tinted-delta: Chinoiserie Morandi (base16-chinoiserie-morandi)
; Scheme author: Di Wang (https://cs.cmu.edu/~diw3)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#c4cbcf bg=#1d1d1d red=#c06061 green=#8ca07b
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#373737"
	plus-style = green
	plus-emph-style = bold green "#373737"
	minus-empty-line-marker-style = normal "#c06061"
	plus-empty-line-marker-style = normal "#8ca07b"
	line-numbers-minus-style = "#c06061"
	line-numbers-plus-style = "#8ca07b"
	line-numbers-zero-style = "#918072"
	line-numbers-left-style = "#918072"
	line-numbers-right-style = "#918072"
	file-style = bold "#839ec9"
	file-decoration-style = "#839ec9" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#918072" box
	hunk-header-file-style = "#98a1d8"
	hunk-header-line-number-style = "#e5bc84"
	commit-style = raw
	commit-decoration-style = "#e5bc84" box
	blame-palette = "#1d1d1d #282828"
	map-styles = bold purple => syntax "#373737", bold cyan => syntax "#282828"
