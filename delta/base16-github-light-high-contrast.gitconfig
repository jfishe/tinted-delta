; tinted-delta: Github Light High Contrast (base16-github-light-high-contrast)
; Scheme author: Tinted Theming (https://github.com/tinted-theming)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#454c54 bg=#ffffff red=#a0111f green=#024c1a
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#d1d9e0"
	plus-style = green
	plus-emph-style = bold green "#d1d9e0"
	minus-empty-line-marker-style = normal "#a0111f"
	plus-empty-line-marker-style = normal "#024c1a"
	line-numbers-minus-style = "#a0111f"
	line-numbers-plus-style = "#024c1a"
	line-numbers-zero-style = "#818b98"
	line-numbers-left-style = "#818b98"
	line-numbers-right-style = "#818b98"
	file-style = bold "#0349b4"
	file-decoration-style = "#0349b4" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#818b98" box
	hunk-header-file-style = "#622cbc"
	hunk-header-line-number-style = "#603700"
	commit-style = raw
	commit-decoration-style = "#603700" box
	blame-palette = "#ffffff #f6f8fa"
	map-styles = bold purple => syntax "#d1d9e0", bold cyan => syntax "#f6f8fa"
