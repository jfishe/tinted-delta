; tinted-delta: Fruit Soda (base16-fruit-soda)
; Scheme author: jozip
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#515151 bg=#f1ecf1 red=#fe3e31 green=#47f74c
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#d8d5d5"
	plus-style = green
	plus-emph-style = bold green "#d8d5d5"
	minus-empty-line-marker-style = normal "#fe3e31"
	plus-empty-line-marker-style = normal "#47f74c"
	line-numbers-minus-style = "#fe3e31"
	line-numbers-plus-style = "#47f74c"
	line-numbers-zero-style = "#b5b4b6"
	line-numbers-left-style = "#b5b4b6"
	line-numbers-right-style = "#b5b4b6"
	file-style = bold "#2931df"
	file-decoration-style = "#2931df" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#b5b4b6" box
	hunk-header-file-style = "#611fce"
	hunk-header-line-number-style = "#f7e203"
	commit-style = raw
	commit-decoration-style = "#f7e203" box
	blame-palette = "#f1ecf1 #e0dee0"
	map-styles = bold purple => syntax "#d8d5d5", bold cyan => syntax "#e0dee0"
