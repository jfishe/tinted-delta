; tinted-delta: Penumbra Light Contrast Plus (base16-penumbra-light-contrast-plus)
; Scheme author: Zachary Weiss (https://github.com/zacharyweiss)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#636363 bg=#fffdfb red=#df7f78 green=#50b584
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#f2e6d4"
	plus-style = green
	plus-emph-style = bold green "#f2e6d4"
	minus-empty-line-marker-style = normal "#df7f78"
	plus-empty-line-marker-style = normal "#50b584"
	line-numbers-minus-style = "#df7f78"
	line-numbers-plus-style = "#50b584"
	line-numbers-zero-style = "#cecece"
	line-numbers-left-style = "#cecece"
	line-numbers-right-style = "#cecece"
	file-style = bold "#61a3e6"
	file-decoration-style = "#61a3e6" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#cecece" box
	hunk-header-file-style = "#a48fe1"
	hunk-header-line-number-style = "#9ca748"
	commit-style = raw
	commit-decoration-style = "#9ca748" box
	blame-palette = "#fffdfb #fff7ed"
	map-styles = bold purple => syntax "#f2e6d4", bold cyan => syntax "#fff7ed"
