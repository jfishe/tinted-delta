; tinted-delta: Stranger Theme Hawkins (base16-stranger-theme-hawkins)
; Scheme author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#e8dcc8 bg=#2c2218 red=#bf616a green=#a3be8c
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#4d4339"
	plus-style = green
	plus-emph-style = bold green "#4d4339"
	minus-empty-line-marker-style = normal "#bf616a"
	plus-empty-line-marker-style = normal "#a3be8c"
	line-numbers-minus-style = "#bf616a"
	line-numbers-plus-style = "#a3be8c"
	line-numbers-zero-style = "#9e8766"
	line-numbers-left-style = "#9e8766"
	line-numbers-right-style = "#9e8766"
	file-style = bold "#b48ead"
	file-decoration-style = "#b48ead" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#9e8766" box
	hunk-header-file-style = "#d4a574"
	hunk-header-line-number-style = "#ebcb8b"
	commit-style = raw
	commit-decoration-style = "#ebcb8b" box
	blame-palette = "#2c2218 #40362c"
	map-styles = bold purple => syntax "#4d4339", bold cyan => syntax "#40362c"
