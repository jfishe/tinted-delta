; tinted-delta: Brogrammer (base24-brogrammer)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#c1c8d7 bg=#131313 red=#f71118 green=#2cc55d
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#2a3141"
	plus-style = green
	plus-emph-style = bold green "#2a3141"
	minus-empty-line-marker-style = normal "#f71118"
	plus-empty-line-marker-style = normal "#2cc55d"
	line-numbers-minus-style = "#f71118"
	line-numbers-plus-style = "#2cc55d"
	line-numbers-zero-style = "#343d50"
	line-numbers-left-style = "#343d50"
	line-numbers-right-style = "#343d50"
	file-style = bold "#2a84d2"
	file-decoration-style = "#2a84d2" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#343d50" box
	hunk-header-file-style = "#4e59b7"
	hunk-header-line-number-style = "#0f80d5"
	commit-style = raw
	commit-decoration-style = "#0f80d5" box
	blame-palette = "#131313 #1f1f1f"
	map-styles = bold purple => syntax "#2a3141", bold cyan => syntax "#1f1f1f"
