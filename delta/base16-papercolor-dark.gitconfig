; tinted-delta: PaperColor Dark (base16-papercolor-dark)
; Scheme author: Jon Leopard (http://github.com/jonleopard), Tinted Theming (https://github.com/tinted-theming), based on PaperColor Theme (https://github.com/NLKNguyen/papercolor-theme)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#9e9e9e bg=#1c1c1c red=#ff5faf green=#5faf5f
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#424242"
	plus-style = green
	plus-emph-style = bold green "#424242"
	minus-empty-line-marker-style = normal "#ff5faf"
	plus-empty-line-marker-style = normal "#5faf5f"
	line-numbers-minus-style = "#ff5faf"
	line-numbers-plus-style = "#5faf5f"
	line-numbers-zero-style = "#585858"
	line-numbers-left-style = "#585858"
	line-numbers-right-style = "#585858"
	file-style = bold "#5fafd7"
	file-decoration-style = "#5fafd7" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#585858" box
	hunk-header-file-style = "#af87d7"
	hunk-header-line-number-style = "#ffaf00"
	commit-style = raw
	commit-decoration-style = "#ffaf00" box
	blame-palette = "#1c1c1c #363636"
	map-styles = bold purple => syntax "#424242", bold cyan => syntax "#363636"
