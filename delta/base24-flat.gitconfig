; tinted-delta: Flat (base24-flat)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#8c939a bg=#082845 red=#a82320 green=#2d9440
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#2e2e45"
	plus-style = green
	plus-emph-style = bold green "#2e2e45"
	minus-empty-line-marker-style = normal "#a82320"
	plus-empty-line-marker-style = normal "#2d9440"
	line-numbers-minus-style = "#a82320"
	line-numbers-plus-style = "#2d9440"
	line-numbers-zero-style = "#444e5b"
	line-numbers-left-style = "#444e5b"
	line-numbers-right-style = "#444e5b"
	file-style = bold "#3167ac"
	file-decoration-style = "#3167ac" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#444e5b" box
	hunk-header-file-style = "#781aa0"
	hunk-header-line-number-style = "#3c7dd2"
	commit-style = raw
	commit-decoration-style = "#3c7dd2" box
	blame-palette = "#082845 #1d2845"
	map-styles = bold purple => syntax "#2e2e45", bold cyan => syntax "#1d2845"
