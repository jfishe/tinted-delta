; tinted-delta: Chinoiserie Night (base16-chinoiserie-night)
; Scheme author: Di Wang (https://cs.cmu.edu/~diw3)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#c4cbcf bg=#1d1d1d red=#f07c82 green=#b2cf87
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#373737"
	plus-style = green
	plus-emph-style = bold green "#373737"
	minus-empty-line-marker-style = normal "#f07c82"
	plus-empty-line-marker-style = normal "#b2cf87"
	line-numbers-minus-style = "#f07c82"
	line-numbers-plus-style = "#b2cf87"
	line-numbers-zero-style = "#918072"
	line-numbers-left-style = "#918072"
	line-numbers-right-style = "#918072"
	file-style = bold "#8fb2c9"
	file-decoration-style = "#8fb2c9" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#918072" box
	hunk-header-file-style = "#be9db9"
	hunk-header-line-number-style = "#f4ce69"
	commit-style = raw
	commit-decoration-style = "#f4ce69" box
	blame-palette = "#1d1d1d #282828"
	map-styles = bold purple => syntax "#373737", bold cyan => syntax "#282828"
