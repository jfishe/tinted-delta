; tinted-delta: Hopscotch (base16-hopscotch)
; Scheme author: Jan T. Sott
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#b9b5b8 bg=#322931 red=#dd464c green=#8fc13e
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#5c545b"
	plus-style = green
	plus-emph-style = bold green "#5c545b"
	minus-empty-line-marker-style = normal "#dd464c"
	plus-empty-line-marker-style = normal "#8fc13e"
	line-numbers-minus-style = "#dd464c"
	line-numbers-plus-style = "#8fc13e"
	line-numbers-zero-style = "#797379"
	line-numbers-left-style = "#797379"
	line-numbers-right-style = "#797379"
	file-style = bold "#1290bf"
	file-decoration-style = "#1290bf" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#797379" box
	hunk-header-file-style = "#c85e7c"
	hunk-header-line-number-style = "#fdcc59"
	commit-style = raw
	commit-decoration-style = "#fdcc59" box
	blame-palette = "#322931 #433b42"
	map-styles = bold purple => syntax "#5c545b", bold cyan => syntax "#433b42"
