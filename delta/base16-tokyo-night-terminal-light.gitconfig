; tinted-delta: Tokyo Night Terminal Light (base16-tokyo-night-terminal-light)
; Scheme author: Michaël Ball
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#4c505e bg=#d5d6db red=#8c4351 green=#33635c
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#dfe0e5"
	plus-style = green
	plus-emph-style = bold green "#dfe0e5"
	minus-empty-line-marker-style = normal "#8c4351"
	plus-empty-line-marker-style = normal "#33635c"
	line-numbers-minus-style = "#8c4351"
	line-numbers-plus-style = "#33635c"
	line-numbers-zero-style = "#9699a3"
	line-numbers-left-style = "#9699a3"
	line-numbers-right-style = "#9699a3"
	file-style = bold "#34548a"
	file-decoration-style = "#34548a" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#9699a3" box
	hunk-header-file-style = "#5a4a78"
	hunk-header-line-number-style = "#8f5e15"
	commit-style = raw
	commit-decoration-style = "#8f5e15" box
	blame-palette = "#d5d6db #cbccd1"
	map-styles = bold purple => syntax "#dfe0e5", bold cyan => syntax "#cbccd1"
