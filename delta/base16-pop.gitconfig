; tinted-delta: Pop (base16-pop)
; Scheme author: Chris Kempson (http://chriskempson.com)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#d0d0d0 bg=#000000 red=#eb008a green=#37b349
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#303030"
	plus-style = green
	plus-emph-style = bold green "#303030"
	minus-empty-line-marker-style = normal "#eb008a"
	plus-empty-line-marker-style = normal "#37b349"
	line-numbers-minus-style = "#eb008a"
	line-numbers-plus-style = "#37b349"
	line-numbers-zero-style = "#505050"
	line-numbers-left-style = "#505050"
	line-numbers-right-style = "#505050"
	file-style = bold "#0e5a94"
	file-decoration-style = "#0e5a94" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#505050" box
	hunk-header-file-style = "#b31e8d"
	hunk-header-line-number-style = "#f8ca12"
	commit-style = raw
	commit-decoration-style = "#f8ca12" box
	blame-palette = "#000000 #202020"
	map-styles = bold purple => syntax "#303030", bold cyan => syntax "#202020"
