; tinted-delta: Cyberpunk (base16-cyberpunk)
; Scheme author: benjujo
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#dcdccc bg=#000000 red=#ff0000 green=#61ce3c
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#383838"
	plus-style = green
	plus-emph-style = bold green "#383838"
	minus-empty-line-marker-style = normal "#ff0000"
	plus-empty-line-marker-style = normal "#61ce3c"
	line-numbers-minus-style = "#ff0000"
	line-numbers-plus-style = "#61ce3c"
	line-numbers-zero-style = "#4f4f4f"
	line-numbers-left-style = "#4f4f4f"
	line-numbers-right-style = "#4f4f4f"
	file-style = bold "#4c83ff"
	file-decoration-style = "#4c83ff" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#4f4f4f" box
	hunk-header-file-style = "#ff1493"
	hunk-header-line-number-style = "#ffff00"
	commit-style = raw
	commit-decoration-style = "#ffff00" box
	blame-palette = "#000000 #2b2b2b"
	map-styles = bold purple => syntax "#383838", bold cyan => syntax "#2b2b2b"
