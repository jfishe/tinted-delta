; tinted-delta: Heetch Light (base16-heetch-light)
; Scheme author: Geoffrey Teale (tealeg@gmail.com), Tinted Theming (https://github.com/tinted-theming)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#5a496e bg=#feffff red=#f80059 green=#5bb66a
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#bdb6c5"
	plus-style = green
	plus-emph-style = bold green "#bdb6c5"
	minus-empty-line-marker-style = normal "#f80059"
	plus-empty-line-marker-style = normal "#5bb66a"
	line-numbers-minus-style = "#f80059"
	line-numbers-plus-style = "#5bb66a"
	line-numbers-zero-style = "#9c92a8"
	line-numbers-left-style = "#9c92a8"
	line-numbers-right-style = "#9c92a8"
	file-style = bold "#5ba2b6"
	file-decoration-style = "#5ba2b6" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#9c92a8" box
	hunk-header-file-style = "#8f6c97"
	hunk-header-line-number-style = "#bd9701"
	commit-style = raw
	commit-decoration-style = "#bd9701" box
	blame-palette = "#feffff #dedae2"
	map-styles = bold purple => syntax "#bdb6c5", bold cyan => syntax "#dedae2"
