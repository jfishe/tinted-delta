; tinted-delta: Rosé Pine Dawn (base16-rose-pine-dawn)
; Scheme author: Emilia Dunfelt &lt;edun@dunfelt.se&gt;
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#575279 bg=#faf4ed red=#b4637a green=#286983
[delta]
	light = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#f2e9de"
	plus-style = green
	plus-emph-style = bold green "#f2e9de"
	minus-empty-line-marker-style = normal "#b4637a"
	plus-empty-line-marker-style = normal "#286983"
	line-numbers-minus-style = "#b4637a"
	line-numbers-plus-style = "#286983"
	line-numbers-zero-style = "#9893a5"
	line-numbers-left-style = "#9893a5"
	line-numbers-right-style = "#9893a5"
	file-style = bold "#907aa9"
	file-decoration-style = "#907aa9" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#9893a5" box
	hunk-header-file-style = "#ea9d34"
	hunk-header-line-number-style = "#d7827e"
	commit-style = raw
	commit-decoration-style = "#d7827e" box
	blame-palette = "#faf4ed #fffaf3"
	map-styles = bold purple => syntax "#f2e9de", bold cyan => syntax "#fffaf3"
