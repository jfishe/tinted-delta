; tinted-delta: Pandora (base24-pandora)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#b8beba bg=#131d42 red=#ff4242 green=#74af68
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#3e5548"
	plus-style = green
	plus-emph-style = bold green "#3e5548"
	minus-empty-line-marker-style = normal "#ff4242"
	plus-empty-line-marker-style = normal "#74af68"
	line-numbers-minus-style = "#ff4242"
	line-numbers-plus-style = "#74af68"
	line-numbers-zero-style = "#66786e"
	line-numbers-left-style = "#66786e"
	line-numbers-right-style = "#66786e"
	file-style = bold "#338f86"
	file-decoration-style = "#338f86" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#66786e" box
	hunk-header-file-style = "#9413e5"
	hunk-header-line-number-style = "#23d7d7"
	commit-style = raw
	commit-decoration-style = "#23d7d7" box
	blame-palette = "#131d42 #000000"
	map-styles = bold purple => syntax "#3e5548", bold cyan => syntax "#000000"
