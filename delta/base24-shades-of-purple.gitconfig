; tinted-delta: Shades Of Purple (base24-shades-of-purple)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#afafaf bg=#1e1d40 red=#d90429 green=#3ad900
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#676767"
	plus-style = green
	plus-emph-style = bold green "#676767"
	minus-empty-line-marker-style = normal "#d90429"
	plus-empty-line-marker-style = normal "#3ad900"
	line-numbers-minus-style = "#d90429"
	line-numbers-plus-style = "#3ad900"
	line-numbers-zero-style = "#7f7f7f"
	line-numbers-left-style = "#7f7f7f"
	line-numbers-right-style = "#7f7f7f"
	file-style = bold "#6943ff"
	file-decoration-style = "#6943ff" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#7f7f7f" box
	hunk-header-file-style = "#ff2b70"
	hunk-header-line-number-style = "#6871ff"
	commit-style = raw
	commit-decoration-style = "#6871ff" box
	blame-palette = "#1e1d40 #000000"
	map-styles = bold purple => syntax "#676767", bold cyan => syntax "#000000"
