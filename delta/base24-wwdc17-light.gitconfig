; tinted-delta: WWDC17 Light (base24-wwdc17-light)
; Scheme author: jfishe (generated by colortemplate2tinty)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#5f5f61 bg=#fafafa red=#e8503f green=#00998c
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#888888"
	plus-style = green
	plus-emph-style = bold green "#888888"
	minus-empty-line-marker-style = normal "#e8503f"
	plus-empty-line-marker-style = normal "#00998c"
	line-numbers-minus-style = "#e8503f"
	line-numbers-plus-style = "#00998c"
	line-numbers-zero-style = "#888888"
	line-numbers-left-style = "#888888"
	line-numbers-right-style = "#888888"
	file-style = bold "#527f8f"
	file-decoration-style = "#527f8f" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#888888" box
	hunk-header-file-style = "#db2d45"
	hunk-header-line-number-style = "#e1ad0b"
	commit-style = raw
	commit-decoration-style = "#e1ad0b" box
	blame-palette = "#fafafa #f0f0f0"
	map-styles = bold purple => syntax "#888888", bold cyan => syntax "#f0f0f0"
