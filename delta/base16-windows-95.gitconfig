; tinted-delta: Windows 95 (base16-windows-95)
; Scheme author: Fergus Collins (https://github.com/ferguscollins)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#a8a8a8 bg=#000000 red=#fc5454 green=#54fc54
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#383838"
	plus-style = green
	plus-emph-style = bold green "#383838"
	minus-empty-line-marker-style = normal "#fc5454"
	plus-empty-line-marker-style = normal "#54fc54"
	line-numbers-minus-style = "#fc5454"
	line-numbers-plus-style = "#54fc54"
	line-numbers-zero-style = "#545454"
	line-numbers-left-style = "#545454"
	line-numbers-right-style = "#545454"
	file-style = bold "#5454fc"
	file-decoration-style = "#5454fc" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#545454" box
	hunk-header-file-style = "#fc54fc"
	hunk-header-line-number-style = "#fcfc54"
	commit-style = raw
	commit-decoration-style = "#fcfc54" box
	blame-palette = "#000000 #1c1c1c"
	map-styles = bold purple => syntax "#383838", bold cyan => syntax "#1c1c1c"
