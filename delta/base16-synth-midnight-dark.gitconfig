; tinted-delta: Synth Midnight Terminal Dark (base16-synth-midnight-dark)
; Scheme author: Michaël Ball (http://github.com/michael-ball/)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#c1c3c4 bg=#050608 red=#b53b50 green=#06ea61
[delta]
	dark = true
	true-color = always
	syntax-theme = base16
	minus-style = red
	minus-emph-style = bold red "#28292a"
	plus-style = green
	plus-emph-style = bold green "#28292a"
	minus-empty-line-marker-style = normal "#b53b50"
	plus-empty-line-marker-style = normal "#06ea61"
	line-numbers-minus-style = "#b53b50"
	line-numbers-plus-style = "#06ea61"
	line-numbers-zero-style = "#474849"
	line-numbers-left-style = "#474849"
	line-numbers-right-style = "#474849"
	file-style = bold "#03aeff"
	file-decoration-style = "#03aeff" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#474849" box
	hunk-header-file-style = "#ea5ce2"
	hunk-header-line-number-style = "#c9d364"
	commit-style = raw
	commit-decoration-style = "#c9d364" box
	blame-palette = "#050608 #1a1b1c"
	map-styles = bold purple => syntax "#28292a", bold cyan => syntax "#1a1b1c"
