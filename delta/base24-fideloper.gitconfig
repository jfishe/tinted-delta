; tinted-delta: Fideloper (base24-fideloper)
; Scheme author: FredHappyface (https://github.com/fredHappyface)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#b1b1a3 bg=#282f32 red=#ca1d2c green=#edb7ab
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#092027"
	plus-style = green
	plus-emph-style = bold green "#092027"
	minus-empty-line-marker-style = normal "#ca1d2c"
	plus-empty-line-marker-style = normal "#edb7ab"
	line-numbers-minus-style = "#ca1d2c"
	line-numbers-plus-style = "#edb7ab"
	line-numbers-zero-style = "#415050"
	line-numbers-left-style = "#415050"
	line-numbers-right-style = "#415050"
	file-style = bold "#2e78c1"
	file-decoration-style = "#2e78c1" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#415050" box
	hunk-header-file-style = "#c0226e"
	hunk-header-line-number-style = "#7c84c4"
	commit-style = raw
	commit-decoration-style = "#7c84c4" box
	blame-palette = "#282f32 #282f32"
	map-styles = bold purple => syntax "#092027", bold cyan => syntax "#282f32"
