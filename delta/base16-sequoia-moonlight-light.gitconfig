; tinted-delta: Sequoia Moonlight Light (base16-sequoia-moonlight-light)
; Scheme author: Micheal Andreuzza (https://michaelandreuzza.com/)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#282930 bg=#edeef2 red=#c94da8 green=#4a85d4
[delta]
	light = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#e2e3e8"
	plus-style = green
	plus-emph-style = bold green "#e2e3e8"
	minus-empty-line-marker-style = normal "#c94da8"
	plus-empty-line-marker-style = normal "#4a85d4"
	line-numbers-minus-style = "#c94da8"
	line-numbers-plus-style = "#4a85d4"
	line-numbers-zero-style = "#565760"
	line-numbers-left-style = "#565760"
	line-numbers-right-style = "#565760"
	file-style = bold "#9a5fd9"
	file-decoration-style = "#9a5fd9" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#565760" box
	hunk-header-file-style = "#6a6a78"
	hunk-header-line-number-style = "#6a6a78"
	commit-style = raw
	commit-decoration-style = "#6a6a78" box
	blame-palette = "#edeef2 #e2e3e8"
	map-styles = bold purple => syntax "#e2e3e8", bold cyan => syntax "#e2e3e8"
