; tinted-delta: Gruvbox 8 Hard Dark (base16-gruvbox8-hard-dark)
; Scheme author: jfishe (generated by colortemplate2tinty)
; Template: https://github.com/jfishe/tinted-delta
;
; Include from ~/.gitconfig:  [include] path = ~/.config/delta/tinty.gitconfig
; apply-delta.py (the tinty hook) replaces the four plus/minus styles with
; backgrounds blended from these colors:
; tinted-delta-vars: fg=#ebdbb2 bg=#1d2021 red=#fb4934 green=#b8bb26
[delta]
	dark = true
	true-color = always
	syntax-theme = ansi
	minus-style = red
	minus-emph-style = bold red "#504945"
	plus-style = green
	plus-emph-style = bold green "#504945"
	minus-empty-line-marker-style = normal "#fb4934"
	plus-empty-line-marker-style = normal "#b8bb26"
	line-numbers-minus-style = "#fb4934"
	line-numbers-plus-style = "#b8bb26"
	line-numbers-zero-style = "#928374"
	line-numbers-left-style = "#928374"
	line-numbers-right-style = "#928374"
	file-style = bold "#83a598"
	file-decoration-style = "#83a598" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#928374" box
	hunk-header-file-style = "#d3869b"
	hunk-header-line-number-style = "#fabd2f"
	commit-style = raw
	commit-decoration-style = "#fabd2f" box
	blame-palette = "#1d2021 #3c3836"
	map-styles = bold purple => syntax "#504945", bold cyan => syntax "#3c3836"
